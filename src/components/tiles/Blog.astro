---
import { getCollection } from 'astro:content';
import Tile from '../Tile.astro';
import site from '../../content/site.json';
import { formatDate } from '../../lib/format';

/* The blog as macOS Mail: an inbox whose newest post slides in the first time the tile is seen. */
const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const href = (p: (typeof posts)[number]) => p.data.url ?? `/writing/${p.id}/`;
const ext = (h: string) => (/^https?:/.test(h) ? { target: '_blank', rel: 'noopener' } : {});
const short = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---

<Tile id="blog" size="2x1" area="blog" flush class="mail-tile">
  <section class="mail" aria-labelledby="blog-app" data-mail>
    <header class="mail__bar">
      <span class="mail__lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <div class="mail__heading">
        <h2 id="blog-app" class="mail__title">Blog</h2>
        <span class="mail__sub">Inbox · {posts.length} {posts.length === 1 ? 'post' : 'posts'} on Medium</span>
      </div>
      <a class="mail__follow" href={site.links.medium} target="_blank" rel="noopener">Follow</a>
    </header>
    <div class="mail__body">
      <nav class="mail__side" aria-label="Mailboxes">
        <p class="mail__side-label">Favourites</p>
        <a class="mail__box is-on" href="/writing/">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2"></path><path d="M5.5 5h13L22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"></path></svg>
          Inbox <b>{posts.length}</b>
        </a>
        <a class="mail__box" href={site.links.medium} target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="7" cy="12" rx="5" ry="5"></ellipse><ellipse cx="15.5" cy="12" rx="2.5" ry="4.7"></ellipse><ellipse cx="20.5" cy="12" rx="1" ry="4.3"></ellipse></svg>
          Medium
        </a>
        <a class="mail__box" href={`mailto:${site.email}`}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4z"></path><path d="M22 2 11 13"></path></svg>
          Write to me
        </a>
      </nav>
      <ul class="mail__list">
        {
          posts.slice(0, 3).map((p, i) => (
            <li class:list={['mail__msg', { 'mail__msg--new': i === 0 }]} data-mail-new={i === 0 ? '' : undefined}>
              <a href={href(p)} {...ext(href(p))}>
                <span class="mail__from">
                  {i === 0 && <span class="mail__unread" aria-hidden="true" />}
                  {site.name}
                  <time datetime={p.data.date.toISOString()} title={formatDate(p.data.date)}>
                    {short(p.data.date)}
                  </time>
                </span>
                <span class="mail__subject">{p.data.title}</span>
                <span class="mail__preview">{p.data.excerpt}</span>
              </a>
            </li>
          ))
        }
        <li class="mail__msg mail__msg--pinned">
          <a href="/about/">
            <span class="mail__from">
              {site.name}
              <span class="mail__pin">Pinned</span>
            </span>
            <span class="mail__subject">Welcome, and thanks for stopping by</span>
            <span class="mail__preview">New posts land here first. Until the next one, here's a little more about me and how I test.</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Tile>

<style>
  .mail {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .mail__bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }
  .mail__lights {
    display: flex;
    gap: 7px;
  }
  .mail__lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.2) inset;
  }
  .mail__lights i:nth-child(2) {
    background: #febc2e;
  }
  .mail__lights i:nth-child(3) {
    background: #28c840;
  }
  .mail__heading {
    display: grid;
    line-height: 1.2;
  }
  .mail__title {
    margin: 0;
    font-size: 15px;
    letter-spacing: 0;
  }
  .mail__sub {
    font-size: 12px;
    color: var(--muted);
  }
  .mail__follow {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 14px;
    border-radius: 999px;
    background: #0a63d6;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }
  .mail__follow:hover {
    background: #0852b3;
  }
  .mail__body {
    flex: 1;
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    min-height: 0;
  }
  .mail__side {
    padding: 12px 10px;
    border-right: 1px solid var(--line);
    background: color-mix(in srgb, var(--text) 3%, transparent);
  }
  .mail__side-label {
    margin: 0 0 6px 8px;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
  }
  .mail__box {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    padding: 0 8px;
    border-radius: 8px;
    font-size: 13px;
    color: var(--body-text);
    text-decoration: none;
  }
  .mail__box svg {
    color: #1677f0;
    flex: none;
  }
  .mail__box b {
    margin-left: auto;
    font-weight: 500;
    color: var(--muted);
  }
  .mail__box.is-on {
    background: color-mix(in srgb, var(--text) 9%, transparent);
    color: var(--text);
  }
  .mail__box:hover:not(.is-on) {
    background: var(--hover);
  }
  .mail__list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
  .mail__msg + .mail__msg {
    border-top: 1px solid var(--line);
  }
  .mail__msg a {
    display: grid;
    gap: 2px;
    padding: 12px 18px 12px 26px;
    text-decoration: none;
  }
  .mail__msg a:hover {
    background: var(--hover);
  }
  .mail__from {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }
  .mail__from time,
  .mail__pin {
    margin-left: auto;
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
  }
  .mail__unread {
    position: absolute;
    left: -15px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 50%;
    background: #1677f0;
  }
  .mail__subject {
    font-size: 14px;
    color: var(--text);
  }
  .mail__preview {
    font-size: 13px;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* The newest post arrives: it fades and slides into the space already kept for it, so
     nothing below the inbox moves. */
  .mail[data-arriving] .mail__msg--new {
    opacity: 0;
    transform: translateY(-14px);
  }
  .mail[data-arrived] .mail__msg--new {
    opacity: 1;
    transform: none;
    transition: transform 0.5s var(--ease-arrive), opacity 0.4s;
  }
  @media (max-width: 599px) {
    .mail__body {
      grid-template-columns: 1fr;
    }
    .mail__side {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mail]').forEach((mail) => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || document.visibilityState === 'hidden' || !('IntersectionObserver' in window)) return;
    const rect = mail.getBoundingClientRect();
    if (rect.top < window.innerHeight) return; // already on screen at load: just show it
    mail.dataset.arriving = '';
    let done = false;
    const arrive = () => {
      if (done) return;
      done = true;
      io.disconnect();
      window.removeEventListener('beforeprint', arrive);
      window.setTimeout(() => {
        delete mail.dataset.arriving;
        mail.dataset.arrived = '';
      }, 400);
    };
    // Any part of the inbox on screen is enough; printing shows it straight away.
    const io = new IntersectionObserver(([e]) => e?.isIntersecting && arrive(), { threshold: 0.1 });
    io.observe(mail);
    window.addEventListener('beforeprint', arrive);
    // Never leave the newest post folded away, even if the observer never reports in.
    window.setTimeout(arrive, 8000);
  });
</script>

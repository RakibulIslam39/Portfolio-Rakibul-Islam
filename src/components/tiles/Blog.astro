---
import { getCollection } from 'astro:content';
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import { formatDate, readingTime } from '../../lib/format';

const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts[0];
---

{
  latest && (
    <Tile id="blog" size="2x1" area="blog" app="Blog" href="/writing/" hrefLabel="See all blog posts" class="blog-tile">
      <AppIcon name="blog" slot="icon" />
      <article class="bt">
        <p class="bt__meta">
          Latest post · {latest.data.category} · {latest.data.minutes ?? readingTime(latest.body ?? '')} min read
        </p>
        <h3 class="bt__title">
          <a
            href={latest.data.url ?? `/writing/${latest.id}/`}
            target={latest.data.url ? '_blank' : undefined}
            rel={latest.data.url ? 'noopener' : undefined}
          >
            {latest.data.title}
          </a>
        </h3>
        <p class="bt__excerpt">{latest.data.excerpt}</p>
        <p class="bt__foot">
          <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
          {latest.data.source && <span>Read on {latest.data.source} ↗</span>}
        </p>
      </article>
    </Tile>
  )
}

<style>
  .bt {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
  }
  .bt__meta {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }
  .bt__title {
    margin: 0;
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .bt__title a {
    color: var(--text);
    text-decoration: none;
  }
  .bt__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .bt__title a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bt__excerpt {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    max-width: 56ch;
  }
  .bt__foot {
    margin: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 13px;
    color: var(--muted);
  }
  .bt__foot span {
    font-weight: 600;
    color: var(--text);
  }
</style>

---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';

const certs = [...site.certifications].sort((a, b) => b.date.localeCompare(a.date));
const shown = certs.slice(0, 3);
const issuers = [...new Set(certs.map((c) => c.issuer))];
---

<Tile id="certificates" size="2x1" area="certs" app="Certificates" href="/certificates/" hrefLabel={`See all ${certs.length} certificates`} class="certs-tile">
  <AppIcon name="certificates" slot="icon" />
  <div class="ct">
    <ul class="ct__stack" aria-hidden="true">
      {
        shown.map((c, i) => (
          <li style={`--i: ${i}`}>
            <img src={c.thumb} width={c.w} height={c.h} alt="" loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ul>
    <div class="ct__text">
      <p class="ct__count"><strong>{certs.length}</strong> certificates</p>
      <p class="ct__from">{issuers.join(' · ')}</p>
      <ul class="ct__list">
        {shown.map((c) => <li>{c.title}</li>)}
      </ul>
      <a class="ct__more" href="/certificates/">See all certificates →</a>
    </div>
  </div>
</Tile>

<style>
  .ct {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
    align-items: center;
    height: 100%;
  }
  .ct__stack {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    aspect-ratio: 4 / 3;
    margin: 18px 30px 0 0;
  }
  .ct__stack li {
    position: absolute;
    inset: 0;
    transform: translate(calc(var(--i) * 10px), calc(var(--i) * -10px)) rotate(calc((var(--i) - 1) * 3deg));
    z-index: calc(3 - var(--i));
    transition: transform 0.35s var(--ease-arrive);
  }
  .certs-tile:hover .ct__stack li {
    transform: translate(calc(var(--i) * 18px), calc(var(--i) * -14px)) rotate(calc((var(--i) - 1) * 5deg));
  }
  .ct__stack img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: 0 0 0 1px var(--tile-edge), 0 8px 20px rgb(0 0 0 / 0.12);
  }
  .ct__count {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }
  .ct__count strong {
    display: block;
    font-size: 44px;
    line-height: 1;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.03em;
  }
  .ct__from {
    margin: 6px 0 10px;
    font-size: 13px;
    color: var(--muted);
  }
  .ct__list {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    font-size: 14px;
    color: var(--text);
  }
  .ct__list li {
    padding: 2px 0;
  }
  .ct__more {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  @media (max-width: 479px) {
    .ct {
      grid-template-columns: 1fr;
    }
    .ct__stack {
      width: 75%;
      margin: 20px 0 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ct__stack li {
      transition: none;
    }
  }
</style>

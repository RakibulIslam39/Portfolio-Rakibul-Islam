---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';

// The WPPOOL plugins I test, with their real WordPress.org icons and active installs.
const total = site.plugins.reduce((n, p) => n + p.installs, 0);
const short = (n: number) => (n >= 1000 ? `${n / 1000}K+` : `${n}+`);
---

<Tile id="plugins" size="1x1" area="plugins" app="Plugins I test" class="plugins">
  <AppIcon name="wordpress" slot="icon" />
  <ul class="plg">
    {
      site.plugins.map((p) => (
        <li>
          <span class="plg__icon">
            <img class:list={[{ 'brand-logo brand-logo--light': p.iconDark }]} src={p.icon} width="36" height="36" alt="" loading="lazy" decoding="async" />
            {p.iconDark && <img class="brand-logo brand-logo--dark" src={p.iconDark} width="36" height="36" alt="" loading="lazy" decoding="async" />}
          </span>
          <a class="plg__text" href={`https://wordpress.org/plugins/${p.slug}/`} target="_blank" rel="noopener">
            <strong>{p.name}</strong>
            <span>{p.does}</span>
          </a>
          <span class="plg__n" title="Active installs on WordPress.org">
            {short(p.installs)}
          </span>
        </li>
      ))
    }
  </ul>
  <p class="plg__total">
    <strong>{total.toLocaleString('en-US')}+</strong> active installs on WordPress.org
  </p>
</Tile>

<style>
  .plg {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .plg li {
    position: relative;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
  }
  .plg li + li {
    border-top: 1px solid var(--line);
  }
  .plg__icon {
    display: grid;
    line-height: 0;
  }
  .plg__icon img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }
  .plg__text {
    display: grid;
    min-width: 0;
    line-height: 1.3;
    text-decoration: none;
  }
  /* The whole row opens the plugin's WordPress.org page. */
  .plg__text::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .plg li:hover strong {
    text-decoration: underline;
  }
  .plg__text strong {
    font-size: 14px;
    color: var(--text);
  }
  .plg__text span {
    font-size: 12px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .plg__n {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .plg__total {
    margin: auto 0 0;
    padding-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }
  .plg__total strong {
    color: var(--text);
  }
</style>

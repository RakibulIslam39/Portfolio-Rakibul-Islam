---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';
import map from '../../data/findmy.json';

/* Find My: Rakibul's pin walks a loop around Road No. 5, Rupnagar Road (Dhaka 1216).
 * Streets come from OpenStreetMap (src/data/findmy.json); the walk is drawn in code. */
const [x0, y0] = map.route[0] as [number, number, string];
const view = { x: 220, y: 204, w: 250, h: 250 };
const label = (a: [number, number], b: [number, number]) => {
  const ang = (Math.atan2(b[1] - a[1], b[0] - a[0]) * 180) / Math.PI;
  return ang > 90 || ang < -90 ? ang + 180 : ang;
};
---

<Tile id="map" size="1x1" area="map" class="findmy" flush>
  <div class="map__canvas" data-map>
    <div class="map__layers" data-map-layers>
    <svg
      class="map__svg"
      viewBox={`${view.x} ${view.y} ${view.w} ${view.h}`}
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      data-map-svg
      data-zoom="1"
    >
      <rect x="-200" y="-200" width="1100" height="1100" class="m-land"></rect>
      {map.parks.map((d) => <path class="m-park" d={d} />)}
      {map.water.map((d) => <path class="m-water" d={d} />)}
      {map.streams.map((d) => <path class="m-stream" d={d} />)}
      {map.roads.filter((r) => r[0] !== 'm').map((r) => <path class:list={['m-road', `m-road--${r[0]}`]} d={r[1]} />)}
      {map.roads.filter((r) => r[0] === 'm').map((r) => <path class="m-road m-road--m" d={r[1]} />)}
      <path class="m-route" d={'M' + map.route.map((p) => `${p[0]} ${p[1]}`).join('L')} />
      <text class="m-label m-label--main" transform={`translate(258 345) rotate(${label([297, 395], [268, 291])})`}>Rupnagar Rd</text>
      <text class="m-label" transform={`translate(356 330) rotate(${label([287, 359], [423, 318])})`}>Road No. 5</text>
    </svg>
    <svg class="map__svg map__svg--pin" viewBox={`${view.x} ${view.y} ${view.w} ${view.h}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="m-pin" data-pin transform={`translate(${x0} ${y0})`}>
        <circle class="m-pin__ring" r="9"></circle>
        <circle r="7.2" fill="#fff"></circle>
        <clipPath id="pin-clip"><circle r="6.2"></circle></clipPath>
        <image
          data-me
          href="/portrait/photo-192.webp"
          data-photo="/portrait/photo-192.webp"
          data-avatar="/portrait/avatar-192.webp"
          x="-6.2"
          y="-6.2"
          width="12.4"
          height="12.4"
          clip-path="url(#pin-clip)"
          preserveAspectRatio="xMidYMid slice"
        ></image>
      </g>
    </svg>
    </div>
    <div class="map__zoom">
      <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
    </div>
    <a class="map__credit" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap</a>
  </div>
  <div class="map__label">
    <AppIcon name="map" />
    <div>
      <strong>{site.firstName} · <span data-street>Road No. 5</span></strong>
      <span>Rupnagar, Dhaka 1216 · {site.timezone}</span>
    </div>
  </div>
  <script type="application/json" data-route set:html={JSON.stringify(map.route)} />
</Tile>

<style>
  .map__canvas {
    position: relative;
    flex: 1;
    min-height: 170px;
    overflow: hidden;
  }
  .map__layers {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    transition: transform 0.45s var(--ease-arrive);
  }
  .map__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The walking pin lives on its own layer so moving it never repaints the streets. */
  .map__svg--pin {
    will-change: transform;
  }
  .m-land {
    fill: #1c2026;
  }
  .m-park {
    fill: #1f3527;
  }
  .m-water {
    fill: #17324a;
  }
  .m-stream {
    fill: none;
    stroke: #17324a;
    stroke-width: 6;
    stroke-linecap: round;
  }
  .m-road {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke: #353b45;
    stroke-width: 7;
  }
  .m-road--s,
  .m-road--f {
    stroke-width: 3.5;
    stroke: #2c3139;
  }
  .m-road--f {
    stroke-dasharray: 3 4;
  }
  .m-road--m {
    stroke: #6b5a33;
    stroke-width: 11;
  }
  .m-route {
    fill: none;
    stroke: #3a8bff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 2 6;
    opacity: 0.85;
  }
  .m-label {
    font: 600 9px/1 var(--font-sans, system-ui);
    fill: #aeb4bf;
    paint-order: stroke;
    stroke: #1c2026;
    stroke-width: 3px;
    text-anchor: middle;
  }
  .m-label--main {
    font-size: 10px;
    fill: #e0c27a;
  }
  .m-pin__ring {
    fill: #3a8bff;
    opacity: 0.35;
    transform-origin: 0 0;
    animation: ping 2s var(--ease-travel) infinite;
  }
  .m-pin {
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
  }
  :global([data-theme='light']) .m-land {
    fill: #f2efe9;
  }
  :global([data-theme='light']) .m-park {
    fill: #cfe8c9;
  }
  :global([data-theme='light']) .m-water {
    fill: #aad3f0;
  }
  :global([data-theme='light']) .m-stream {
    stroke: #aad3f0;
  }
  :global([data-theme='light']) .m-road {
    stroke: #ffffff;
  }
  :global([data-theme='light']) .m-road--s,
  :global([data-theme='light']) .m-road--f {
    stroke: #e3ded4;
  }
  :global([data-theme='light']) .m-road--m {
    stroke: #f7d58a;
  }
  :global([data-theme='light']) .m-label {
    fill: #5d6470;
    stroke: #f2efe9;
  }
  :global([data-theme='light']) .m-label--main {
    fill: #8a6a1f;
  }
  @keyframes ping {
    from {
      transform: scale(1);
      opacity: 0.45;
    }
    to {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  .map__zoom {
    position: absolute;
    right: 10px;
    top: 10px;
    display: flex;
    flex-direction: column;
    border-radius: 10px;
    overflow: hidden;
    background: var(--glass);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
  }
  .map__zoom button {
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    color: var(--text);
  }
  .map__zoom button + button {
    border-top: 1px solid var(--line);
  }
  .map__credit {
    position: absolute;
    left: 8px;
    bottom: 6px;
    font-size: 10px;
    color: var(--muted);
    text-decoration: none;
    background: var(--glass);
    padding: 0 6px;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
  }
  .map__label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    font-size: 13px;
    line-height: 1.3;
  }
  .map__label strong {
    display: block;
    color: var(--text);
  }
  .map__label span {
    color: var(--muted);
  }
  .map__label strong span {
    color: var(--text);
  }
  @media (prefers-reduced-motion: reduce) {
    .m-pin__ring {
      animation: none;
    }
  }
</style>

<script>
  import { applyLook, savedLook } from '../../scripts/look';

  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const svg = map.querySelector<SVGSVGElement>('[data-map-svg]')!;
    const layers = map.querySelector<HTMLElement>('[data-map-layers]')!;
    let zoom = 1;
    map.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        zoom = Math.min(2.5, Math.max(1, zoom + (b.dataset.zoom === 'in' ? 0.5 : -0.5)));
        layers.style.transform = `scale(${zoom})`;
        svg.dataset.zoom = String(zoom);
      }),
    );

    // The walk: the pin moves along the route at a steady pace, one loop every 45 s.
    const tile = map.closest('.tile')!;
    const route = JSON.parse(tile.querySelector('[data-route]')!.textContent!) as [number, number, string][];
    const pin = map.querySelector<SVGGElement>('[data-pin]')!;
    const street = tile.querySelector<HTMLElement>('[data-street]')!;
    const legs = route.slice(1).map((p, i) => {
      const a = route[i]!;
      return { a, b: p, len: Math.hypot(p[0] - a[0], p[1] - a[1]), name: p[2] };
    });
    const total = legs.reduce((n, l) => n + l.len, 0);
    const LOOP = 45000;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let visible = true;
    new IntersectionObserver(([e]) => (visible = !!e?.isIntersecting)).observe(map);
    let t0 = 0;
    let last = 0;
    const frame = (now: number) => {
      t0 ||= now;
      // ~25 frames a second is plenty for a walking pin and keeps the main thread quiet.
      if (visible && !document.hidden && now - last > 40) {
        last = now;
        let d = (((now - t0) % LOOP) / LOOP) * total;
        for (const leg of legs) {
          if (d <= leg.len) {
            const k = leg.len ? d / leg.len : 0;
            pin.setAttribute('transform', `translate(${(leg.a[0] + (leg.b[0] - leg.a[0]) * k).toFixed(1)} ${(leg.a[1] + (leg.b[1] - leg.a[1]) * k).toFixed(1)})`);
            if (street.textContent !== leg.name) street.textContent = leg.name;
            break;
          }
          d -= leg.len;
        }
      }
      requestAnimationFrame(frame);
    };
    // Start walking once the page has finished loading, so the walk never competes with it.
    const start = () => requestAnimationFrame(frame);
    if (document.readyState === 'complete') window.setTimeout(start, 800);
    else window.addEventListener('load', () => window.setTimeout(start, 800), { once: true });
  });
  applyLook(savedLook());
</script>

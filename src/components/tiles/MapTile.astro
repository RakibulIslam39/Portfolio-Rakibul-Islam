---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';
---

<Tile id="map" size="1x1" area="map" class="map" flush>
  <div class="map__canvas" data-map>
    <svg class="map__svg" viewBox="0 0 240 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-map-svg>
      <rect width="240" height="240" class="m-land"></rect>
      <path class="m-river" d="M-10 170 C40 150 70 190 110 175 S170 120 250 135" />
      <path class="m-river m-river--thin" d="M120 -10 C110 40 140 70 130 110 S150 160 140 250" />
      <g class="m-road">
        <path d="M0 60 H240 M0 120 H240 M60 0 V240 M180 0 V240 M20 0 L230 230 M0 210 L210 0" />
      </g>
      <g class="m-park"><rect x="150" y="40" width="40" height="28" rx="6"></rect><rect x="30" y="80" width="26" height="22" rx="6"></rect></g>
    </svg>
    <div class="map__pin" aria-hidden="true"><span></span></div>
    <div class="map__zoom">
      <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
    </div>
  </div>
  <div class="map__label">
    <AppIcon name="map" />
    <div>
      <strong>{site.location}</strong>
      <span>Remote · {site.timezone}</span>
    </div>
  </div>
</Tile>

<style>
  .map__canvas {
    position: relative;
    flex: 1;
    min-height: 170px;
    overflow: hidden;
  }
  .map__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-origin: 50% 50%;
    transition: transform 0.45s var(--ease-arrive);
  }
  .m-land {
    fill: #1f2a22;
  }
  .m-river {
    fill: none;
    stroke: #1f4f73;
    stroke-width: 16;
    stroke-linecap: round;
  }
  .m-river--thin {
    stroke-width: 8;
  }
  .m-road path {
    fill: none;
    stroke: #3a463e;
    stroke-width: 4;
  }
  .m-park rect {
    fill: #27452f;
  }
  :global([data-theme='light']) .m-land {
    fill: #eef1ea;
  }
  :global([data-theme='light']) .m-river {
    stroke: #a9d2f2;
  }
  :global([data-theme='light']) .m-road path {
    stroke: #ffffff;
  }
  :global([data-theme='light']) .m-park rect {
    fill: #cfe8c9;
  }
  .map__pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    border-radius: 50%;
    background: var(--link);
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }
  .map__pin span {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--link);
    animation: ping 2s var(--ease-travel) infinite;
  }
  @keyframes ping {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
  .map__zoom {
    position: absolute;
    right: 10px;
    top: 10px;
    display: flex;
    flex-direction: column;
    border-radius: 10px;
    overflow: hidden;
    background: var(--glass);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
  }
  .map__zoom button {
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    color: var(--text);
  }
  .map__zoom button + button {
    border-top: 1px solid var(--line);
  }
  .map__label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    font-size: 13px;
    line-height: 1.3;
  }
  .map__label strong {
    display: block;
    color: var(--text);
  }
  .map__label span {
    color: var(--muted);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const svg = map.querySelector<SVGElement>('[data-map-svg]')!;
    let zoom = 1;
    map.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        zoom = Math.min(2.5, Math.max(1, zoom + (b.dataset.zoom === 'in' ? 0.5 : -0.5)));
        svg.style.transform = `scale(${zoom})`;
        svg.dataset.zoom = String(zoom);
      }),
    );
  });
</script>

---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';
import map from '../../data/findmy.json';
import { VIEW as view } from '../../lib/findmy';

/* Find My: Rakibul's pin walks a loop around Road No. 5, Rupnagar Road (Dhaka 1216).
 * The streets are a static picture made at build time from OpenStreetMap data
 * (src/lib/findmy.ts → /findmy/dark.svg and /findmy/light.svg). Only the pin is live: it walks
 * with SVG's own animateMotion, so moving it costs no JavaScript per frame. */
const routePath = 'M' + map.route.map((p) => `${p[0]} ${p[1]}`).join('L');
const [x0, y0] = map.route[0] as [number, number, string];
---

<Tile id="map" size="1x1" area="map" class="findmy" flush>
  <div class="map__canvas" data-map>
    <div class="map__layers" data-map-layers>
      <img class="map__img map__img--dark" src="/findmy/dark.svg" width="500" height="500" alt="" fetchpriority="low" decoding="async" />
      <img class="map__img map__img--light" src="/findmy/light.svg" width="500" height="500" alt="" fetchpriority="low" decoding="async" />
      <svg
        class="map__svg map__svg--pin"
        viewBox={`${view.x} ${view.y} ${view.w} ${view.h}`}
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        data-map-svg
        data-zoom="1"
      >
        <g class="m-pin" data-pin transform={`translate(${x0} ${y0})`}>
          <g data-pin-walker>
            <animateMotion dur="45s" repeatCount="indefinite" path={routePath} begin="indefinite" data-walk />
            <circle class="m-pin__ring" r="9"></circle>
            <circle r="7.2" fill="#fff"></circle>
            <clipPath id="pin-clip"><circle r="6.2"></circle></clipPath>
            <image
              data-me
              href="/portrait/photo-192.webp"
              data-photo="/portrait/photo-192.webp"
              data-avatar="/portrait/avatar-192.webp"
              x="-6.2"
              y="-6.2"
              width="12.4"
              height="12.4"
              clip-path="url(#pin-clip)"
              preserveAspectRatio="xMidYMid slice"
            ></image>
          </g>
        </g>
      </svg>
    </div>
    <div class="map__zoom">
      <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
    </div>
    <a class="map__credit" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap</a>
  </div>
  <div class="map__label">
    <AppIcon name="map" />
    <div>
      <strong>{site.firstName} · <span data-street>Road No. 5</span></strong>
      <span>Rupnagar, Dhaka 1216 · {site.timezone}</span>
    </div>
  </div>
  <script type="application/json" data-route set:html={JSON.stringify(map.route)} />
</Tile>

<style>
  .map__canvas {
    position: relative;
    flex: 1;
    min-height: 170px;
    overflow: hidden;
  }
  .map__layers {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    transition: transform 0.45s var(--ease-arrive);
  }
  .map__svg,
  .map__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .map__img {
    object-fit: cover;
  }
  .map__img--light,
  :global([data-theme='light']) .map__img--dark {
    display: none;
  }
  :global([data-theme='light']) .map__img--light {
    display: block;
  }
  /* The walking pin lives on its own layer so moving it never repaints the streets. */
  .map__svg--pin {
    will-change: transform;
  }
  .m-pin__ring {
    fill: #3a8bff;
    opacity: 0.35;
    transform-origin: 0 0;
  }
  .is-walking .m-pin__ring {
    animation: ping 2s var(--ease-travel) infinite;
  }
  .m-pin {
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
  }
  @keyframes ping {
    from {
      transform: scale(1);
      opacity: 0.45;
    }
    to {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  .map__zoom {
    position: absolute;
    right: 10px;
    top: 10px;
    display: flex;
    flex-direction: column;
    border-radius: 10px;
    overflow: hidden;
    background: var(--glass);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
  }
  .map__zoom button {
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    color: var(--text);
  }
  .map__zoom button + button {
    border-top: 1px solid var(--line);
  }
  .map__credit {
    position: absolute;
    left: 8px;
    bottom: 6px;
    font-size: 10px;
    color: var(--muted);
    text-decoration: none;
    background: var(--glass);
    padding: 0 6px;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
  }
  .map__label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    font-size: 13px;
    line-height: 1.3;
  }
  .map__label strong {
    display: block;
    color: var(--text);
  }
  .map__label span {
    color: var(--muted);
  }
  .map__label strong span {
    color: var(--text);
  }
  @media (prefers-reduced-motion: reduce) {
    .m-pin__ring {
      animation: none;
    }
  }
</style>

<script>
  import { applyLook, savedLook } from '../../scripts/look';

  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const svg = map.querySelector<SVGSVGElement>('[data-map-svg]')!;
    const layers = map.querySelector<HTMLElement>('[data-map-layers]')!;
    let zoom = 1;
    map.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        zoom = Math.min(2.5, Math.max(1, zoom + (b.dataset.zoom === 'in' ? 0.5 : -0.5)));
        layers.style.transform = `scale(${zoom})`;
        svg.dataset.zoom = String(zoom);
      }),
    );

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // The walk: the pin follows the route (animateMotion starts at the route's first point,
    // so the group's own offset is cleared). The street name is looked up twice a second.
    const tile = map.closest('.tile')!;
    const route = JSON.parse(tile.querySelector('[data-route]')!.textContent!) as [number, number, string][];
    const street = tile.querySelector<HTMLElement>('[data-street]')!;
    const legs = route.slice(1).map((p, i) => ({ len: Math.hypot(p[0] - route[i]![0], p[1] - route[i]![1]), name: p[2] }));
    const total = legs.reduce((n, l) => n + l.len, 0);
    const LOOP = 45;
    const walk = map.querySelector<SVGAnimationElement>('[data-walk]')!;

    const start = () => {
      map.querySelector('[data-pin]')!.setAttribute('transform', '');
      walk.beginElement();
      const t0 = svg.getCurrentTime();
      window.setInterval(() => {
        if (document.hidden) return;
        let d = (((svg.getCurrentTime() - t0) % LOOP) / LOOP) * total;
        for (const leg of legs) {
          if (d <= leg.len) {
            if (street.textContent !== leg.name) street.textContent = leg.name;
            break;
          }
          d -= leg.len;
        }
      }, 500);
    };
    // Start walking on the visitor's first move (mouse, touch, scroll or key), so the animation
    // never competes with the page loading and an idle background tab stays idle.
    let started = false;
    const go = () => {
      if (started) return;
      started = true;
      events.forEach((ev) => window.removeEventListener(ev, go));
      map.classList.add('is-walking');
      start();
    };
    const events = ['pointermove', 'pointerdown', 'scroll', 'keydown', 'touchstart'] as const;
    events.forEach((ev) => window.addEventListener(ev, go, { once: true, passive: true }));
  });
  applyLook(savedLook());
</script>

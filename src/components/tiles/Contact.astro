---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';
---

<Tile id="contact" size="1x1" area="contact" app="Contact" class="contact">
  <AppIcon name="contact" slot="icon" />
  <div class="contact__card">
    <img class="contact__me" data-me src="/portrait/photo-192.webp" data-photo="/portrait/photo-192.webp" data-avatar="/portrait/avatar-192.webp" width="48" height="48" alt="" loading="lazy" decoding="async" />
    <p class="contact__q">Got a release that needs a safety net?</p>
  </div>
  <ul class="contact__list">
    <li><a class="tap" href={`mailto:${site.email}`}><AppIcon name="gmail" size={22} /><span>Email</span></a></li>
    <li><a class="tap" href={site.links.linkedin} target="_blank" rel="me noopener"><AppIcon name="linkedin" size={22} /><span>LinkedIn</span></a></li>
    <li><a class="tap" href={site.links.github} target="_blank" rel="me noopener"><AppIcon name="github" size={22} /><span>GitHub</span></a></li>
    <li><a class="tap" href={site.links.medium} target="_blank" rel="me noopener"><AppIcon name="medium" size={22} /><span>Medium</span></a></li>
    <li><a class="tap" href={site.links.wordpress} target="_blank" rel="me noopener"><AppIcon name="wordpress" size={22} /><span>WordPress.org</span></a></li>
  </ul>
  <div class="contact__copy">
    <span class="contact__copy-label">Email</span>
    <span class="contact__copy-value">{site.email}</span>
    <button class="contact__copy-btn" type="button" data-copy-email={site.email} hidden>Copy</button>
    <span class="sr-only" aria-live="polite" data-copy-status></span>
  </div>
  <dl class="contact__facts">
    <div><dt>Status</dt><dd><span class="contact__dot" aria-hidden="true"></span>{site.status.headline}</dd></div>
    <div><dt>Local time</dt><dd><span data-contact-time>Dhaka</span> · UTC+6</dd></div>
  </dl>
  <div class="contact__actions">
    <a class="btn" href="/Rakibul-Islam-CV.pdf" download>Download CV</a>
    <a class="btn" href="/rakibul-islam.vcf" download>Save contact</a>
  </div>
</Tile>

<style>
  .contact__card {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }
  .contact__me {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--tile), 0 0 0 3px var(--line);
  }
  .contact__q {
    margin: 0;
    color: var(--text);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
  }
  .contact__list {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    font-size: 15px;
  }
  .contact__list li + li {
    border-top: 1px solid var(--line);
  }
  .contact__list a {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--link);
  }
  .contact__list a::after {
    content: '↗';
    margin-left: auto;
    color: var(--muted);
  }
  .contact__list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact__copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2px 8px;
    padding: 10px 12px;
    margin-bottom: 14px;
    border-radius: 12px;
    background: var(--hover);
  }
  .contact__copy-label {
    grid-column: 1;
    font-size: 11px;
    color: var(--muted);
  }
  .contact__copy-value {
    grid-column: 1;
    font-size: 13.5px;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .contact__copy-btn {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: var(--tile);
    color: var(--text);
    font-size: 12.5px;
    font-weight: 600;
    box-shadow: 0 0 0 1px var(--line) inset;
    cursor: pointer;
  }
  .contact__facts {
    margin: 0 0 14px;
    display: grid;
    gap: 8px;
    font-size: 13px;
  }
  .contact__facts div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .contact__facts dt {
    color: var(--muted);
  }
  .contact__facts dd {
    margin: 0;
    color: var(--text);
    text-align: right;
  }
  .contact__dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 50%;
    background: var(--pass);
    vertical-align: 1px;
  }
  .contact__actions {
    margin-top: auto;
    display: grid;
    gap: 8px;
  }
  .contact__actions .btn {
    justify-content: center;
    min-height: var(--tap);
  }
</style>

<script>
  // Local time in Dhaka, so visitors know whether I'm likely awake.
  document.querySelectorAll<HTMLElement>('[data-contact-time]').forEach((el) => {
    const f = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Dhaka', hour: '2-digit', minute: '2-digit' });
    const tick = () => (el.textContent = `${f.format(new Date())} in Dhaka`);
    tick();
    window.setInterval(tick, 30_000);
  });

  import { applyLook, savedLook } from '../../scripts/look';
  applyLook(savedLook());

  // The Copy button needs the Clipboard API (https or localhost); without it the button stays hidden.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
    if (!navigator.clipboard) return;
    btn.hidden = false;
    const status = btn.parentElement!.querySelector('[data-copy-status]')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyEmail!);
        btn.textContent = 'Copied';
        status.textContent = 'Email address copied';
        window.setTimeout(() => (btn.textContent = 'Copy'), 1800);
      } catch {
        status.textContent = 'Could not copy. The address is shown above.';
      }
    });
  });
</script>

---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';
---

<Tile id="contact" size="1x1" area="contact" app="Contact" class="contact">
  <AppIcon name="contact" slot="icon" />
  <p class="contact__q">Got a release that needs a safety net?</p>
  <ul class="contact__list">
    <li><a class="tap" href={`mailto:${site.email}`}>Email</a></li>
    <li><a class="tap" href={site.links.linkedin} target="_blank" rel="me noopener">LinkedIn</a></li>
    <li><a class="tap" href={site.links.github} target="_blank" rel="me noopener">GitHub</a></li>
  </ul>
  <div class="contact__actions">
    <a class="btn" href="/Rakibul-Islam-CV.pdf" download>Download CV</a>
    <a class="btn" href="/rakibul-islam.vcf" download>Save contact</a>
  </div>
</Tile>

<style>
  .contact__q {
    color: var(--text);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
  }
  .contact__list {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    font-size: 15px;
  }
  .contact__list li + li {
    border-top: 1px solid var(--line);
  }
  .contact__list a {
    display: flex;
    justify-content: space-between;
    text-decoration: none;
    color: var(--link);
  }
  .contact__list a::after {
    content: '↗';
    color: var(--muted);
  }
  .contact__list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact__actions {
    margin-top: auto;
    display: grid;
    gap: 8px;
  }
  .contact__actions .btn {
    justify-content: center;
    min-height: var(--tap);
  }
</style>

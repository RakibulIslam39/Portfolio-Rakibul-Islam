---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';
---

<Tile id="contact" size="1x1" app="Contact" class="contact">
  <AppIcon name="contact" slot="icon" />
  <p class="contact__q">Got a release that needs a safety net?</p>
  <ul class="contact__list">
    <li><a href={`mailto:${site.email}`}>Email</a></li>
    <li><a href={site.links.linkedin} target="_blank" rel="me noopener">LinkedIn</a></li>
    <li><a href={site.links.github} target="_blank" rel="me noopener">GitHub</a></li>
  </ul>
  <a class="btn contact__save" href="/rakibul-islam.vcf" download>Save contact</a>
</Tile>

<style>
  .contact__q {
    color: var(--text);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
  }
  .contact__list {
    list-style: none;
    margin: 0 0 auto;
    padding: 0;
    font-size: 14px;
  }
  .contact__list li + li {
    border-top: 1px solid var(--line);
  }
  .contact__list a {
    display: flex;
    justify-content: space-between;
    padding: 7px 0;
    text-decoration: none;
    color: var(--link);
  }
  .contact__list a::after {
    content: '↗';
    color: var(--muted);
  }
  .contact__save {
    justify-content: center;
    margin-top: 12px;
  }
</style>

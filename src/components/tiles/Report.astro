---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';
import Terminal from './Terminal.astro';

const { total, note } = site.report;
const project = site.projects[0]!;
---

<Tile id="report" size="2x2" area="report" app="Test report" href={`/projects/${project.slug}/`} hrefLabel={`Read the ${project.name} case study`} class="report">
  <AppIcon name="report" slot="icon" />
  <div class="rep">
    <div class="rep__top">
      <h3 class="rep__title">{project.name}</h3>
      <p class="rep__note">{note}</p>
    </div>
    <p class="rep__summary" aria-label={`${total} passed, 0 failed`}>
      <span class="rep__pass">{total} passed</span>
      <span class="rep__fail">0 failed</span>
      <span class="rep__total">{total} scenarios</span>
    </p>
    <!-- The run itself: each suite ticks green, with a "Run again" button. -->
    <Terminal />
  </div>
</Tile>

<style>
  /* A soft green wash from the top corner: this tile is the "all green" moment. */
  :global(.tile.report) {
    background:
      radial-gradient(120% 90% at 100% 0%, var(--pass-soft), transparent 60%),
      var(--tile);
  }
  .rep {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rep :global(.window) {
    margin-top: 6px;
  }
  .rep__title {
    font-size: 22px;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .rep__note {
    font-size: 14px;
    color: var(--muted);
    margin: 0;
  }
  .rep__summary {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .rep__pass {
    color: var(--pass);
    font-weight: 600;
  }
  .rep__fail,
  .rep__total {
    color: var(--muted);
  }
</style>

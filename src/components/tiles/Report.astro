---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';

const { total, passRate, note, suites } = site.report;
const project = site.projects[0]!;
---

<Tile id="report" size="2x2" app="Test report" href={`/projects/${project.slug}/`} hrefLabel={`Read the ${project.name} case study`} class="report">
  <AppIcon name="report" slot="icon" />
  <div class="rep">
    <div class="rep__top">
      <div>
        <p class="rep__title">{project.name}</p>
        <p class="rep__note">{note}</p>
      </div>
      <div class="rep__ring" role="img" aria-label={`${passRate}% of ${total} tests passing`} style={`--p:${passRate}`}>
        <span>{passRate}%</span>
      </div>
    </div>

    <ul class="rep__filters" aria-label="Result summary">
      <li class="is-on">All <b>{total}</b></li>
      <li class="ok">Passed <b>{total}</b></li>
      <li class="bad">Failed <b>0</b></li>
    </ul>

    <ul class="rep__suites">
      {
        suites.map((s) => (
          <li>
            <details>
              <summary>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
                <span class="rep__name">{s}</span>
                <span class="rep__tag">passed</span>
              </summary>
              <p>End-to-end scenarios written with Playwright + TypeScript using the Page Object Model.</p>
            </details>
          </li>
        ))
      }
    </ul>

    <p class="rep__foot">
      <span class="pill">Playwright</span><span class="pill">TypeScript</span><span class="pill">POM</span><span class="pill">Docker</span>
    </p>
  </div>
</Tile>

<style>
  .rep {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .rep__top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }
  .rep__title {
    color: var(--text);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .rep__note {
    font-size: 14px;
    color: var(--muted);
    margin: 0;
  }
  .rep__ring {
    --size: 84px;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(closest-side, var(--tile) 78%, transparent 80% 100%),
      conic-gradient(var(--pass) calc(var(--p) * 1%), var(--line) 0);
  }
  .rep__ring span {
    color: var(--text);
    font-weight: 700;
    font-size: 18px;
  }
  .rep__filters {
    list-style: none;
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    font-size: 13px;
  }
  .rep__filters li {
    padding: 4px 10px;
    border-radius: 8px;
    color: var(--muted);
  }
  .rep__filters b {
    margin-left: 4px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--card);
    color: var(--text);
    font-weight: 600;
  }
  .rep__filters .is-on {
    background: var(--card);
    color: var(--text);
  }
  .rep__filters .ok b {
    background: var(--pass-soft);
    color: var(--pass);
  }
  .rep__filters .bad b {
    background: var(--fail-soft);
    color: var(--fail);
  }
  .rep__suites {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .rep__suites li + li {
    border-top: 1px solid var(--line);
  }
  .rep__suites summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    cursor: pointer;
    list-style: none;
    font-size: 14px;
  }
  .rep__suites summary::-webkit-details-marker {
    display: none;
  }
  .rep__suites summary:hover {
    background: var(--hover);
  }
  .rep__suites svg {
    color: var(--pass);
    flex: none;
  }
  .rep__name {
    color: var(--text);
    font-weight: 500;
    flex: 1;
  }
  .rep__tag {
    font-size: 12px;
    color: var(--pass);
  }
  .rep__suites details p {
    margin: 0;
    padding: 0 14px 12px 40px;
    font-size: 13px;
    color: var(--muted);
  }
  .rep__foot {
    margin: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .rep__foot .pill {
    font-size: 12px;
  }
</style>

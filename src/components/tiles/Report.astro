---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';

const { total, note, suites } = site.report;
const project = site.projects[0]!;
---

<Tile id="report" size="2x1" area="report" app="Test report" href={`/projects/${project.slug}/`} hrefLabel={`Read the ${project.name} case study`} class="report">
  <AppIcon name="report" slot="icon" />
  <div class="rep">
    <div class="rep__top">
      <h3 class="rep__title">{project.name}</h3>
      <p class="rep__note">{note}</p>
    </div>
    <p class="rep__summary" aria-label={`${total} passed, 0 failed`}>
      <span class="rep__pass">{total} passed</span>
      <span class="rep__fail">0 failed</span>
      <span class="rep__total">{total} scenarios</span>
    </p>
    <ul class="rep__suites">
      {
        suites.map((s) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12.5l4.5 4.5L19 7.5" />
            </svg>
            <span class="rep__name">{s}</span>
            <span class="rep__tag">passed</span>
          </li>
        ))
      }
    </ul>
  </div>
</Tile>

<style>
  /* A soft green wash from the top corner: this tile is the "all green" moment. */
  :global(.tile.report) {
    background:
      radial-gradient(120% 90% at 100% 0%, var(--pass-soft), transparent 60%),
      var(--tile);
  }
  .rep {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rep__title {
    font-size: 22px;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .rep__note {
    font-size: 14px;
    color: var(--muted);
    margin: 0;
  }
  .rep__summary {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .rep__pass {
    color: var(--pass);
    font-weight: 600;
  }
  .rep__fail,
  .rep__total {
    color: var(--muted);
  }
  .rep__suites {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
  }
  .rep__suites li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .rep__suites svg {
    color: var(--pass);
    flex: none;
  }
  .rep__name {
    color: var(--text);
    font-weight: 500;
    flex: 1;
  }
  .rep__tag {
    font-size: 13px;
    color: var(--pass);
  }
</style>

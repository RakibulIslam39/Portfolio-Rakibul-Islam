---
import site from '../../content/site.json';
/* A terminal window (not a tile): the hero's proof object and the page's one motion moment. */

const { total, suites } = site.report;
const lines = [
  { kind: 'cmd', text: 'npx playwright test' },
  { kind: 'dim', text: `Running ${total} tests` },
  ...suites.map((s) => ({ kind: 'pass', text: s })),
  { kind: 'sum', text: `${total} passed` },
];
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const staticHtml = lines
  .map((l) => `<span class="t-${l.kind}">${l.kind === 'cmd' ? '$ ' : '  '}${l.kind === 'pass' ? '<span class="t-check">✓ </span>' : ''}${esc(l.text)}\n</span>`)
  .join('');
---

<figure class="window" id="terminal" aria-labelledby="terminal-title">
  <figcaption class="window__bar">
    <span class="window__lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span id="terminal-title">Terminal · flexorder-e2e</span>
  </figcaption>
  <div class="term" data-terminal data-lines={JSON.stringify(lines)}>
    <pre class="term__out" data-term-out aria-hidden="true" set:html={staticHtml} />
    <p class="sr-only">Terminal demo: running the Playwright suite, {total} of {total} tests pass.</p>
    <button class="term__replay" type="button" data-term-replay>Run again</button>
  </div>
</figure>

<style>
  .window {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: 18px;
    background: #101012;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 18px 40px -12px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }
  .window__bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: #9d9da6;
    font-size: 13px;
  }
  .window__lights {
    display: flex;
    gap: 7px;
  }
  .window__lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3a3a41;
  }
  .term {
    padding: 18px 20px 16px;
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 150px;
  }
  .term__out {
    flex: 1;
    margin: 0;
    font: 500 13.5px/1.75 var(--font-mono);
    color: #d6d6dc;
    white-space: pre-wrap;
    overflow: hidden;
    padding-bottom: 40px;
  }
  .term__out :global(.t-cmd) {
    color: #fff;
  }
  .term__out :global(.t-dim) {
    color: #8b8b95;
  }
  .term__out :global(.t-pass) {
    color: #c6c6ce;
  }
  .term__out :global(.t-check) {
    color: #2fd08a;
  }
  .term__out :global(.t-sum) {
    color: #2fd08a;
    font-weight: 700;
  }
  .term__out :global(.caret) {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    vertical-align: -2px;
    background: #2fd08a;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .term__replay {
    position: absolute;
    right: 16px;
    bottom: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid #3a3a41;
    background: #1a1a1d;
    color: #d6d6dc;
    font-size: 13px;
    min-height: 36px;
    cursor: pointer;
  }
  .term__replay:hover {
    background: #26262b;
  }
</style>

<script>
  import { initTerminal } from '../../scripts/terminal';
  initTerminal();
</script>

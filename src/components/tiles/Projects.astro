---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';
import ProjectIcon from '../ProjectIcon.astro';
---

<Tile id="projects" size="2x2" area="proj" app="Projects" href="/projects/" hrefLabel="See all projects" class="projects">
  <AppIcon name="projects" slot="icon" />
  <ul class="proj">
    {
      site.projects.map((p) => (
        <li>
          <a class="proj__row" href={`/projects/${p.slug}/`}>
            <span class="proj__icon"><ProjectIcon id={p.slug} size={48} /></span>
            <span class="proj__name">{p.name}</span>
            <span class="proj__hook">{p.hook}</span>
            <span class="proj__summary">{p.summary}</span>
            <span class="proj__stack">{p.stack.join(' · ')}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Tile>

<style>
  .proj {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .proj li + li {
    border-top: 1px solid var(--line);
  }
  .proj__row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 4px;
    padding: 16px 0;
    text-decoration: none;
  }
  .proj li:first-child .proj__row {
    padding-top: 0;
  }
  .proj__name {
    color: var(--text);
    font-weight: 600;
    font-size: 18px;
    font-stretch: var(--display-stretch);
    letter-spacing: -0.015em;
  }
  .proj__row:hover .proj__name {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .proj__hook {
    color: var(--pass);
    font-size: 14px;
    font-weight: 500;
  }
  .proj__summary {
    font-size: 14px;
    line-height: 1.5;
    color: var(--body-text);
  }
  .proj__stack {
    font-size: 13px;
    color: var(--muted);
  }
  .proj__row > :not(.proj__icon) {
    grid-column: 2;
  }
  .proj__icon {
    grid-row: 1 / span 4;
    padding-top: 2px;
  }
</style>

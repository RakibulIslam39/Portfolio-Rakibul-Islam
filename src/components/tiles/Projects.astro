---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';
---

<Tile id="projects" size="2x2" app="Projects" href="/projects/" hrefLabel="See all projects" class="projects">
  <AppIcon name="projects" slot="icon" />
  <ul class="proj">
    {
      site.projects.map((p) => (
        <li>
          <a class="proj__card" href={p.url} target="_blank" rel="noopener">
            <span class="proj__hook">{p.hook}</span>
            <span class="proj__name">{p.name}</span>
            <span class="proj__summary">{p.summary}</span>
            <span class="proj__stack">
              {p.stack.map((s) => (
                <span class="pill">{s}</span>
              ))}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Tile>

<style>
  .proj {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .proj__card {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--card);
    text-decoration: none;
    transition: transform 0.25s var(--ease-arrive), background-color 0.2s;
  }
  .proj__card:hover {
    transform: translateY(-2px);
  }
  .proj__hook {
    font-size: 12px;
    font-weight: 600;
    color: var(--pass);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .proj__name {
    color: var(--text);
    font-weight: 600;
    font-size: 16px;
  }
  .proj__summary {
    font-size: 13px;
    line-height: 1.45;
    color: var(--body-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .proj__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .proj__stack .pill {
    font-size: 11.5px;
    padding: 2px 8px;
    background: var(--tile);
  }
</style>

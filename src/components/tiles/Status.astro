---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
import site from '../../content/site.json';
---

<Tile id="status" size="2x1" area="status" app="Status" class="status">
  <AppIcon name="status" slot="icon" />
  <div class="status__body">
    <p class="status__head"><span class="dot" aria-hidden="true"></span>{site.status.headline}</p>
    <p class="status__detail">{site.status.detail}</p>
  </div>
  <div class="status__foot">
    <p class="status__time">
      Dhaka · <time data-local-time>--:--</time> <span>({site.timezone})</span>
    </p>
    <a class="btn btn--primary" href={`mailto:${site.email}?subject=${encodeURIComponent('A role you might like')}`}>{site.status.cta}</a>
  </div>
</Tile>

<style>
  .status__head {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 24px;
    font-weight: 600;
    font-stretch: var(--display-stretch);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 8px;
  }
  .status__detail {
    font-size: 15px;
    max-width: 40ch;
  }
  .status__foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .status__time {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .status__time time {
    color: var(--text);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
</style>

<script>
  const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Dhaka', hour: '2-digit', minute: '2-digit' });
  const tick = () => {
    document.querySelectorAll<HTMLTimeElement>('[data-local-time]').forEach((t) => {
      t.textContent = fmt.format(new Date());
    });
  };
  tick();
  setInterval(tick, 30_000);
</script>

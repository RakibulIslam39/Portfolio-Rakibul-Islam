---
import Tile from '../Tile.astro';
import AppIcon from '../AppIcon.astro';
---

<Tile id="cv" size="1x1" class="cv" flush>
  <a class="cv__link" href="/Rakibul-Islam-CV.pdf" download>
    <span class="cv__doc" aria-hidden="true">
      <span class="cv__fold"></span>
      <span class="cv__line"></span><span class="cv__line"></span><span class="cv__line cv__line--short"></span>
      <span class="cv__badge">PDF</span>
    </span>
    <span class="cv__text">
      <AppIcon name="cv" />
      <span><strong>Download CV</strong><span>PDF · one page</span></span>
    </span>
  </a>
</Tile>

<style>
  .cv__link {
    flex: 1;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    padding: var(--tile-pad);
    gap: 18px;
  }
  .cv__doc {
    position: relative;
    align-self: center;
    width: 96px;
    flex: 1;
    max-height: 124px;
    min-height: 100px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    padding: 26px 14px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.35s var(--ease-arrive);
  }
  .cv__link:hover .cv__doc {
    transform: translateY(-4px) rotate(-3deg);
  }
  .cv__fold {
    position: absolute;
    right: 0;
    top: 0;
    width: 22px;
    height: 22px;
    background: linear-gradient(225deg, var(--tile) 50%, #dcdce2 50%);
    border-bottom-left-radius: 4px;
  }
  .cv__line {
    height: 6px;
    border-radius: 3px;
    background: #d9d9e0;
  }
  .cv__line--short {
    width: 60%;
  }
  .cv__badge {
    position: absolute;
    left: -10px;
    bottom: 14px;
    padding: 2px 8px;
    border-radius: 6px;
    background: #e0281b;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }
  .cv__text {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 13px;
    line-height: 1.3;
  }
  .cv__text strong {
    display: block;
    color: var(--text);
    font-size: 13px;
    word-break: break-all;
  }
  .cv__text span span {
    color: var(--muted);
  }
</style>

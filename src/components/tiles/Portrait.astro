---
import Tile from '../Tile.astro';
import site from '../../content/site.json';
---

<Tile id="portrait" size="1x1" area="photo" class="portrait" flush>
  <div class="portrait__stage" data-portrait>
    <img
      class="portrait__img portrait__img--photo"
      src="/portrait/photo.webp"
      srcset="/portrait/photo-400.webp 400w, /portrait/photo-640.webp 640w, /portrait/photo.webp 800w"
      sizes="(min-width: 1024px) 340px, (min-width: 700px) 50vw, 100vw"
      width="800"
      height="800"
      alt={site.name}
      fetchpriority="high"
      decoding="async"
    />
    <img
      class="portrait__img portrait__img--avatar"
      src="/portrait/avatar.webp"
      srcset="/portrait/avatar-400.webp 400w, /portrait/avatar-640.webp 640w, /portrait/avatar.webp 800w"
      sizes="(min-width: 1024px) 340px, (min-width: 700px) 50vw, 100vw"
      width="800"
      height="800"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <span class="portrait__glow" aria-hidden="true"></span>
    <p class="portrait__siri" aria-hidden="true"><span class="portrait__orb"></span><span data-siri-text></span></p>
    <button class="portrait__switch" type="button" data-portrait-switch aria-pressed="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"></path><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"></path>
      </svg>
      <span class="sr-only">3D avatar</span>
    </button>
    <p class="portrait__label" aria-hidden="true"><span class="for-photo">Turn me 3D</span><span class="for-avatar">Back to photo</span></p>
  </div>
</Tile>

<style>
  .portrait__stage {
    position: relative;
    flex: 1;
    min-height: 220px;
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
    background: #1d2430;
  }
  .portrait__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.6s var(--ease-travel), transform 0.8s var(--ease-arrive), filter 0.6s;
  }
  .portrait__img--avatar {
    opacity: 0;
    transform: scale(1.06);
  }
  :global([data-look='avatar']) .portrait__img--avatar {
    opacity: 1;
    transform: none;
  }
  :global([data-look='avatar']) .portrait__img--photo {
    opacity: 0;
    transform: scale(1.06);
  }
  .portrait__stage.is-thinking .portrait__img {
    filter: saturate(1.4) brightness(1.08) blur(1.5px);
  }
  .portrait__glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    padding: 4px;
    background: conic-gradient(from var(--spin, 0deg), #ff5f6d, #ffc371, #47e6a0, #3aa0ff, #b36bff, #ff5f6d);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  .portrait__stage.is-thinking .portrait__glow {
    opacity: 1;
    animation: spin 1.1s linear infinite;
  }
  @property --spin {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes spin {
    to {
      --spin: 360deg;
    }
  }
  .portrait__siri {
    position: absolute;
    left: 12px;
    right: 64px;
    bottom: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    margin: 0;
    padding: 6px 12px 6px 8px;
    border-radius: 999px;
    background: rgb(20 20 24 / 0.6);
    backdrop-filter: blur(14px) saturate(1.6);
    -webkit-backdrop-filter: blur(14px) saturate(1.6);
    color: #fff;
    font-size: 12.5px;
    line-height: 1.25;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.25s, transform 0.35s var(--ease-arrive);
    pointer-events: none;
  }
  .portrait__stage.is-thinking .portrait__siri {
    opacity: 1;
    transform: none;
  }
  .portrait__orb {
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 50%;
    background: conic-gradient(from var(--spin, 0deg), #ff5f6d, #ffc371, #47e6a0, #3aa0ff, #b36bff, #ff5f6d);
    animation: spin 1.1s linear infinite;
  }
  .portrait__stage.is-thinking .portrait__label {
    opacity: 0 !important;
  }
  .portrait__switch {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    width: var(--tap);
    height: var(--tap);
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: rgb(20 20 24 / 0.55);
    backdrop-filter: blur(12px) saturate(1.6);
    -webkit-backdrop-filter: blur(12px) saturate(1.6);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18) inset;
    cursor: pointer;
    transition: transform 0.2s var(--ease-arrive), background-color 0.2s;
  }
  .portrait__switch:hover {
    transform: scale(1.08);
    background: rgb(20 20 24 / 0.75);
  }
  .portrait__label {
    position: absolute;
    right: 64px;
    bottom: 22px;
    z-index: 2;
    margin: 0;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(20 20 24 / 0.55);
    color: #fff;
    font-size: 12px;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
  }
  .for-avatar,
  :global([data-look='avatar']) .for-photo {
    display: none;
  }
  :global([data-look='avatar']) .for-avatar {
    display: inline;
  }
  :global(.portrait):hover .portrait__label,
  .portrait__switch:focus-visible + .portrait__label {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait__img {
      transition: none;
    }
    .portrait__stage.is-thinking .portrait__glow {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  import { applyLook, savedLook, setLook } from '../../scripts/look';

  const stage = document.querySelector<HTMLElement>('[data-portrait]');
  const btn = document.querySelector<HTMLButtonElement>('[data-portrait-switch]');
  const sync = () => {
    const avatar = document.documentElement.dataset.look === 'avatar';
    btn?.setAttribute('aria-pressed', String(avatar));
  };
  applyLook(savedLook());
  sync();
  document.addEventListener('look-change', sync);
  const siri = stage?.querySelector<HTMLElement>('[data-siri-text]');
  let busy = false;
  btn?.addEventListener('click', () => {
    if (busy) return;
    const next = document.documentElement.dataset.look === 'avatar' ? 'photo' : 'avatar';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !stage || !siri) {
      setLook(next);
      sync();
      return;
    }
    // A pretend Siri moment: the glow runs round, the request types itself, then the swap.
    busy = true;
    const ask = next === 'avatar' ? 'Turn Rakibul into a 3D avatar' : 'Show Rakibul’s real photo';
    siri.textContent = '';
    stage.classList.add('is-thinking');
    let n = 0;
    const type = window.setInterval(() => {
      siri.textContent = ask.slice(0, ++n);
      if (n >= ask.length) window.clearInterval(type);
    }, 22);
    window.setTimeout(() => {
      setLook(next);
      sync();
    }, 1000);
    window.setTimeout(() => {
      stage.classList.remove('is-thinking');
      busy = false;
    }, 1700);
  });
</script>

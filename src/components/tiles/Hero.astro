---
import Tile from '../Tile.astro';
import site from '../../content/site.json';
import qa from '../../data/qa-report.json';

const ran = qa.tests.total - qa.tests.skipped;
// A flaky test failed once and then passed on retry, so it counts as passing (the /qa page lists it).
const passing = qa.tests.passed + (qa.tests.flaky ?? 0);
const green = qa.tests.failed === 0;
---

<Tile id="hero" size="2x2" area="hero" class="hero">
  <div class="hero__text">
      <h1>
        <span class="hi">{site.name}</span> is a QA Automation Engineer &amp; SDET in <span class="hi">Dhaka</span>
      </h1>
      <div class="hero__copy">
        {site.intro.map((p) => <p>{p}</p>)}
        <p class="hero__tagline">{site.tagline}</p>
      </div>
      <div class="hero__cta">
        <a class="btn btn--primary" href={`mailto:${site.email}?subject=${encodeURIComponent('Hello Rakibul (via your portfolio)')}`}>Email me</a>
        <a class="btn" href="/Rakibul-Islam-CV.pdf" download>Download CV</a>
        {
          !qa.sample && green && (
            <a class="pill hero__qa" href="/qa/">
              <span class="dot" aria-hidden="true" /> This site: {passing}/{ran} tests passing
            </a>
          )
        }
      </div>
  </div>
</Tile>

<style>
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
    justify-content: center;
  }
  :global(.hero) h1 {
    font-size: clamp(34px, 3.6vw, 52px);
    letter-spacing: -0.035em;
    line-height: 1.04;
    color: var(--muted);
  }
  :global(.hero) .hi {
    color: var(--text);
  }
  .hero__copy {
    font-size: 16.5px;
  }
  .hero__copy p:last-child {
    margin-bottom: 0;
  }
  .hero__tagline {
    color: var(--text);
    font-weight: 500;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .hero__qa {
    min-height: var(--tap);
    text-decoration: none;
  }
  .hero__qa:hover {
    border-color: var(--pass);
  }
</style>

---
const items: { href: string; label: string; short?: string; desktopOnly?: boolean }[] = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Blog' },
  { href: '/certificates/', label: 'Certificates', short: 'Certs' },
  // On phones /qa/ stays reachable from the footer and the home Report tile.
  { href: '/qa/', label: 'QA', desktopOnly: true },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="topbar">
  <div class="topbar__inner">
    <a href="/" class="logo">
      <span aria-hidden="true">RI</span>
      <span class="sr-only">Rakibul Islam, home</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          items.map((item) => (
            <li class:list={{ 'nav__desk': item.desktopOnly }}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.short ? (
                  <>
                    <span class="nav__long">{item.label}</span>
                    <span class="nav__short" aria-hidden="true">{item.short}</span>
                  </>
                ) : (
                  item.label
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn search-btn" type="button" data-open-palette aria-keyshortcuts="Control+K Meta+K">
        <span class="sr-only">Search</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <kbd class="kbd" aria-hidden="true">⌘K</kbd>
      </button>
      <button class="icon-btn sound-btn" type="button" data-sound-toggle aria-pressed="true">
        <span class="sr-only">Click sounds</span>
        <svg class="i-sound-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path></svg>
        <svg class="i-sound-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"></path><path d="m16 9 6 6M22 9l-6 6"></path></svg>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch colour theme">
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 16px 0 auto;
    z-index: 50;
    pointer-events: none;
  }
  .topbar__inner {
    width: min(100% - 32px, var(--max-wide));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .logo,
  .nav,
  .actions {
    pointer-events: auto;
  }
  .logo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    border: 1px solid var(--tile-edge);
    box-shadow: var(--shadow);
    color: var(--text);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .nav {
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    border: 1px solid var(--tile-edge);
    box-shadow: var(--shadow);
    border-radius: 999px;
    padding: 5px;
  }
  .nav__short {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: block;
    padding: 7px 14px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }
  .nav a:hover {
    color: var(--text);
    background: var(--hover);
  }
  .nav a[aria-current='page'] {
    color: var(--text);
    background: var(--card);
    view-transition-name: nav-pill;
  }
  .i-sound-off,
  :global([data-sound='off']) .i-sound-on {
    display: none;
  }
  :global([data-sound='off']) .i-sound-off {
    display: block;
  }
  .actions {
    display: flex;
    gap: 8px;
  }
  .icon-btn {
    height: 44px;
    min-width: 44px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 999px;
    border: 1px solid var(--tile-edge);
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    box-shadow: var(--shadow);
    color: var(--text);
    cursor: pointer;
  }
  .kbd {
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--outline);
    border-radius: 6px;
    padding: 1px 5px;
  }
  .i-moon {
    display: none;
  }
  :global([data-theme='light']) .i-sun {
    display: none;
  }
  :global([data-theme='light']) .i-moon {
    display: block;
  }

  @media (max-width: 640px) {
    /* Phones: one glass pill at the bottom holding the links and the three icons. */
    .topbar {
      inset: auto 0 12px;
    }
    .logo,
    .search-btn .kbd {
      display: none;
    }
    .topbar__inner {
      width: calc(100% - 16px);
      max-width: 460px;
      gap: 0;
      padding: 4px;
      border-radius: 999px;
      background: var(--glass);
      backdrop-filter: blur(16px) saturate(1.6);
      -webkit-backdrop-filter: blur(16px) saturate(1.6);
      border: 1px solid var(--tile-edge);
      box-shadow: var(--shadow);
      pointer-events: auto;
    }
    .nav {
      flex: 1;
      min-width: 0;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .nav ul {
      position: relative;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav ul::-webkit-scrollbar {
      display: none;
    }
    .nav a {
      padding: 8px 8px;
      font-size: 13px;
      white-space: nowrap;
    }
    .actions {
      gap: 0;
      flex: none;
    }
    .actions .icon-btn {
      height: 38px;
      min-width: 36px;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .nav .nav__long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .nav .nav__short {
      display: inline;
    }
    .nav .nav__desk {
      display: none;
    }
  }
  /* Very small phones: the theme switch moves to the ⌘K menu to make room for the links. */
  @media (max-width: 399px) {
    .actions [data-theme-toggle] {
      display: none;
    }
  }
</style>

<script>
  import { initTheme } from '../scripts/theme';
  import { initSound } from '../scripts/sound';
  initTheme();
  initSound();
  // On narrow phones the bar can scroll sideways: keep the current page in view.
  const bar = document.querySelector<HTMLElement>('.nav ul');
  const current = bar?.querySelector<HTMLElement>('a[aria-current="page"]');
  if (bar && current && bar.scrollWidth > bar.clientWidth) {
    bar.scrollLeft = current.offsetLeft - (bar.clientWidth - current.offsetWidth) / 2;
  }
</script>

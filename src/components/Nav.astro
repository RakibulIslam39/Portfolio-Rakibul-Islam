---
import { getCollection } from 'astro:content';

const latestPost = (await getCollection('writing')).map((p) => p.data.date.toISOString().slice(0, 10)).sort().at(-1) ?? '';
const items: { href: string; label: string; desktopOnly?: boolean }[] = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Blog' },
  { href: '/certificates/', label: 'Certificates', desktopOnly: true },
  { href: '/gallery/', label: 'Gallery', desktopOnly: true },
  { href: '/qa/', label: 'QA', desktopOnly: true },
];
// On phones the bar has room for four links; the rest open from "More" as a small sheet.
const more = [
  { href: '/certificates/', label: 'Certificates' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/activity/', label: 'Activity' },
  { href: '/qa/', label: 'QA report' },
  { href: '/cv/', label: 'CV' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const inMore = more.some((m) => isActive(m.href));
---

<header class="topbar">
  <div class="topbar__inner">
    <a href="/" class="logo">
      <img class="brand-logo brand-logo--light" src="/brand/logo-light-96.webp" width="30" height="23" alt="" decoding="async" />
      <img class="brand-logo brand-logo--dark" src="/brand/logo-dark-96.webp" width="30" height="23" alt="" decoding="async" />
      <span class="sr-only">Rakibul Islam, home</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          items.map((item) => (
            <li class:list={{ 'nav__desk': item.desktopOnly }}>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                data-latest={item.href === '/writing/' ? latestPost : undefined}
              >
                {item.label}
                {item.href === '/writing/' && <span class="nav__badge" data-new-badge hidden><span class="sr-only">, new post</span></span>}
              </a>
            </li>
          ))
        }
        <li class="nav__more">
          <button type="button" popovertarget="nav-more" aria-current={inMore ? 'page' : undefined}>More</button>
        </li>
      </ul>
      <div id="nav-more" class="more" popover>
        <ul>
          {
            more.map((m) => (
              <li>
                <a href={m.href} aria-current={isActive(m.href) ? 'page' : undefined}>
                  {m.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="actions">
      <button class="icon-btn search-btn" type="button" data-open-palette aria-keyshortcuts="Control+K Meta+K">
        <span class="sr-only">Search</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <kbd class="kbd" aria-hidden="true">⌘K</kbd>
      </button>
      <button class="icon-btn sound-btn" type="button" data-sound-toggle aria-pressed="true">
        <span class="sr-only">Click sounds</span>
        <svg class="i-sound-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path></svg>
        <svg class="i-sound-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"></path><path d="m16 9 6 6M22 9l-6 6"></path></svg>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch colour theme">
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 16px 0 auto;
    z-index: 50;
    pointer-events: none;
  }
  .topbar__inner {
    /* Stays put while the page beneath it changes (see the page transitions in global.css). */
    view-transition-name: topbar;
    width: min(100% - 32px, var(--max-wide));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .logo,
  .nav,
  .actions {
    pointer-events: auto;
  }
  .logo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--glass);
    border: 1px solid var(--tile-edge);
    box-shadow: var(--shadow);
    text-decoration: none;
    overflow: hidden;
  }
  .logo img {
    width: 30px;
    height: auto;
    transition: transform 0.35s var(--ease-arrive, ease);
  }
  /* A nod to the animated logo: the check gives a little nod when you point at it. */
  .logo:hover img,
  .logo:focus-visible img {
    transform: rotate(-6deg) scale(1.08);
  }
  @media (prefers-reduced-motion: reduce) {
    .logo img {
      transition: none;
    }
  }
  .nav {
    background: var(--glass-blur);
    -webkit-backdrop-filter: blur(20px) saturate(1.8);
    backdrop-filter: blur(20px) saturate(1.8);
    border: 1px solid var(--tile-edge);
    box-shadow: var(--shadow);
    border-radius: 999px;
    padding: 5px;
  }
  .nav__more {
    display: none;
  }
  /* A small red dot on Blog, like an app badge, until the visitor has seen the newest post. */
  .nav a {
    position: relative;
  }
  .nav__badge {
    position: absolute;
    top: 5px;
    right: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff3b30;
    box-shadow: 0 0 0 2px var(--glass);
  }
  .nav__badge[hidden] {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a,
  .nav__more button {
    display: block;
    padding: 7px 14px;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 999px;
    color: var(--body-text);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s, transform 0.2s var(--ease-arrive);
  }
  .nav a:hover,
  .nav__more button:hover {
    color: var(--text);
    background: var(--hover);
  }
  .nav__more button[aria-current='page'] {
    color: var(--text);
    background: var(--card);
  }
  .nav > ul a[aria-current='page'] {
    color: var(--text);
    background: var(--card);
    view-transition-name: nav-pill;
  }
  .i-sound-off,
  :global([data-sound='off']) .i-sound-on {
    display: none;
  }
  :global([data-sound='off']) .i-sound-off {
    display: block;
  }
  .actions {
    display: flex;
    gap: 8px;
  }
  .icon-btn {
    height: 44px;
    min-width: 44px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 999px;
    border: 1px solid var(--tile-edge);
    background: var(--glass);
    box-shadow: var(--shadow);
    color: var(--text);
    cursor: pointer;
  }
  .kbd {
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--outline);
    border-radius: 6px;
    padding: 1px 5px;
  }
  .i-moon {
    display: none;
  }
  :global([data-theme='light']) .i-sun {
    display: none;
  }
  :global([data-theme='light']) .i-moon {
    display: block;
  }

  @media (max-width: 640px) {
    /* Phones: one glass pill at the bottom holding the links and the three icons. */
    .topbar {
      inset: auto 0 calc(12px + env(safe-area-inset-bottom));
    }
    .logo,
    .search-btn .kbd {
      display: none;
    }
    .topbar__inner {
      -webkit-backdrop-filter: blur(20px) saturate(1.8);
      backdrop-filter: blur(20px) saturate(1.8);
      width: calc(100% - 16px);
      max-width: 460px;
      gap: 0;
      padding: 4px;
      border-radius: 999px;
      background: var(--glass-blur);
      border: 1px solid var(--tile-edge);
      box-shadow: var(--shadow);
      pointer-events: auto;
    }
    .nav {
      flex: 1;
      min-width: 0;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }
    .nav ul {
      position: relative;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav ul::-webkit-scrollbar {
      display: none;
    }
    .nav a,
    .nav__more button {
      padding: 8px 9px;
      font-size: 13px;
      white-space: nowrap;
    }
    .nav .nav__more {
      display: block;
    }
    .actions {
      gap: 0;
      flex: none;
    }
    .actions .icon-btn {
      height: 38px;
      min-width: 36px;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }
    .nav .nav__desk {
      display: none;
    }
  }
  /* "More": a small glass sheet that opens above the bottom bar (native popover: Esc and
     tapping outside close it, focus is handled by the browser). */
  .more {
    position: fixed;
    inset: auto 8px calc(84px + env(safe-area-inset-bottom)) auto;
    margin: 0;
    width: min(240px, calc(100% - 16px));
    padding: 6px;
    border-radius: 20px;
    border: 1px solid var(--tile-edge);
    background: var(--glass-blur);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    backdrop-filter: blur(24px) saturate(1.8);
    box-shadow: var(--shadow);
    color: var(--text);
  }
  .more:popover-open {
    animation: more-in 0.2s var(--ease-arrive);
  }
  @keyframes more-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }
  .nav .more ul {
    display: grid;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: visible;
  }
  .nav .more a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 14px;
    border-radius: 14px;
    color: var(--text);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }
  .nav .more a:hover {
    background: var(--hover);
  }
  .nav .more a[aria-current='page'] {
    background: var(--card);
  }
  /* Very small phones: the theme switch moves to the ⌘K menu to make room for the links. */
  @media (max-width: 399px) {
    .actions [data-theme-toggle] {
      display: none;
    }
  }
</style>

<script>
  import { initTheme } from '../scripts/theme';
  import { initSound } from '../scripts/sound';
  initTheme();
  initSound();

  // New-post badge: shown until this browser has opened the Blog page since the newest post.
  const blog = document.querySelector<HTMLAnchorElement>('.nav a[data-latest]');
  if (blog?.dataset.latest) {
    let seen = '';
    try {
      seen = localStorage.getItem('blog-seen') ?? '';
      if (location.pathname.startsWith('/writing/')) {
        localStorage.setItem('blog-seen', blog.dataset.latest);
        seen = blog.dataset.latest;
      }
    } catch {
      seen = blog.dataset.latest; // storage blocked: don't nag
    }
    blog.querySelector<HTMLElement>('[data-new-badge]')!.hidden = seen >= blog.dataset.latest;
  }
  // On narrow phones the bar can scroll sideways: keep the current page in view.
  const bar = document.querySelector<HTMLElement>('.nav ul');
  const current = bar?.querySelector<HTMLElement>('a[aria-current="page"]');
  if (bar && current && bar.scrollWidth > bar.clientWidth) {
    bar.scrollLeft = current.offsetLeft - (bar.clientWidth - current.offsetWidth) / 2;
  }
</script>

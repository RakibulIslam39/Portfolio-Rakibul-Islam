---
/**
 * macOS-style app icons: a rounded "squircle" with a vertical gradient, a soft top highlight,
 * a hairline edge and a drop shadow, like the icons in a Mac's Dock. Brand services (GitHub,
 * Medium, Udemy…) use their own logo; everything else is an original glyph.
 */
import { brandPaths } from '../lib/brands';

type Glyph =
  | 'terminal' | 'report' | 'ci' | 'map' | 'contact' | 'projects' | 'timeline' | 'skills' | 'plugins'
  | 'cv' | 'bug' | 'status' | 'portrait' | 'certificates' | 'blog' | 'mail' | 'linkedin'
  | 'github' | 'medium' | 'udemy' | 'gmail' | 'docker' | 'postman' | 'wordpress' | 'githubactions';
interface Props {
  name: Glyph;
  size?: number;
}
const { name, size = 28 } = Astro.props;

// [top colour, bottom colour, glyph colour]
const look: Record<Glyph, [string, string, string]> = {
  terminal: ['#4a4a52', '#16161a', '#3ee08f'],
  report: ['#5ee3a8', '#0e9a62', '#fff'],
  ci: ['#4fa0ff', '#1a5fd6', '#fff'],
  map: ['#7fe08a', '#2aa84f', '#fff'],
  contact: ['#c9a27e', '#8a6545', '#fff'],
  projects: ['#6cc4ff', '#1e88e5', '#fff'],
  timeline: ['#d29bff', '#7b3fe4', '#fff'],
  skills: ['#ffb84d', '#f07b00', '#fff'],
  plugins: ['#3d9bd8', '#21759b', '#fff'],
  cv: ['#ff9a5a', '#e8590c', '#fff'],
  bug: ['#ff6b8a', '#d81b4a', '#fff'],
  status: ['#5ee3a8', '#0e9a62', '#fff'],
  portrait: ['#a0a0aa', '#5d5d66', '#fff'],
  certificates: ['#ffd862', '#e59a00', '#fff'],
  blog: ['#3a3a3a', '#000', '#fff'],
  mail: ['#5fb3ff', '#1677f0', '#fff'],
  linkedin: ['#2a8ad6', '#0a66c2', '#fff'],
  github: ['#3b3f45', '#0d1117', '#fff'],
  medium: ['#3a3a3a', '#000', '#fff'],
  udemy: ['#b866ff', '#8a2be2', '#fff'],
  gmail: ['#ffffff', '#e9e9ee', '#ea4335'],
  docker: ['#4fb3ff', '#1d7fd6', '#fff'],
  postman: ['#ff9566', '#ff5f1f', '#fff'],
  wordpress: ['#3d9bd8', '#21759b', '#fff'],
  githubactions: ['#4fa0ff', '#1a5fd6', '#fff'],
};
const [top, bottom, ink] = look[name];
const uid = `ai-${name}-${size}`;
const medium = name === 'medium' || name === 'blog';
const brand = medium ? undefined : brandPaths[name];
---

<svg class="app-icon" viewBox="0 0 28 28" width={size} height={size} aria-hidden="true">
  <defs>
    <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={top}></stop>
      <stop offset="1" stop-color={bottom}></stop>
    </linearGradient>
    <linearGradient id={`${uid}-gloss`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.32"></stop>
      <stop offset="0.5" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
  </defs>
  <rect width="28" height="28" rx="6.3" fill={`url(#${uid}-bg)`}></rect>
  <rect width="28" height="28" rx="6.3" fill={`url(#${uid}-gloss)`}></rect>
  <rect x="0.25" y="0.25" width="27.5" height="27.5" rx="6.1" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="0.5"></rect>
  {
    brand ? (
      <g transform="translate(6.5 6.5) scale(0.625)">
        <path d={brand} fill={ink} />
      </g>
    ) : medium ? (
      <g fill={ink}>
        <ellipse cx="9.6" cy="14" rx="4.6" ry="4.6" />
        <ellipse cx="16.6" cy="14" rx="2.3" ry="4.3" />
        <ellipse cx="20.6" cy="14" rx="0.85" ry="3.9" />
      </g>
    ) : name === 'linkedin' ? (
      <g fill={ink}>
        <rect x="7.5" y="11.5" width="3" height="9" rx="0.4" />
        <circle cx="9" cy="8.4" r="1.75" />
        <path d="M12.6 11.5h2.9v1.3c.5-.9 1.6-1.5 2.9-1.5 2.3 0 3.1 1.4 3.1 3.6v5.6h-3v-5c0-1.1-.3-1.8-1.3-1.8s-1.6.7-1.6 1.8v5h-3z" />
      </g>
    ) : (
      <g fill="none" stroke={ink} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        {name === 'terminal' && <path d="M8 10l4 4-4 4M14 18h6" />}
        {name === 'report' && <><rect x="8" y="6.5" width="12" height="15" rx="2" /><path d="M11 14.5l2 2 4-4.5" /></>}
        {name === 'status' && <path d="M8.5 14.5l3.5 3.5 7.5-8" />}
        {name === 'ci' && <><circle cx="9" cy="9" r="2" /><circle cx="9" cy="19" r="2" /><circle cx="19" cy="14" r="2" /><path d="M9 11v6M11 9.5c4 0 6 1.5 6.3 2.8" /></>}
        {name === 'map' && <><path d="M14 21.5s5-4.6 5-8.5a5 5 0 0 0-10 0c0 3.9 5 8.5 5 8.5z" fill={ink} stroke="none" /><circle cx="14" cy="13" r="1.9" fill={bottom} stroke="none" /></>}
        {name === 'contact' && <><rect x="7" y="7" width="14" height="14" rx="2.5" /><circle cx="14" cy="12.3" r="2.4" /><path d="M10.2 18.6c.8-1.9 2.2-2.8 3.8-2.8s3 .9 3.8 2.8" /></>}
        {name === 'projects' && <><path d="M6.5 10.5a1.5 1.5 0 0 1 1.5-1.5h4l1.6 1.8H20a1.5 1.5 0 0 1 1.5 1.5v6.7a1.5 1.5 0 0 1-1.5 1.5H8a1.5 1.5 0 0 1-1.5-1.5z" fill={ink} stroke="none" opacity="0.95" /></>}
        {name === 'timeline' && <><rect x="7" y="8" width="14" height="13" rx="2" /><path d="M7 12h14M11 6.5v3M17 6.5v3" /><circle cx="11" cy="16" r="0.6" fill={ink} /><circle cx="14" cy="16" r="0.6" fill={ink} /><circle cx="17" cy="16" r="0.6" fill={ink} /></>}
        {name === 'skills' && <><rect x="6.5" y="11" width="15" height="9.5" rx="1.8" /><path d="M11 11V9.2c0-.7.5-1.2 1.2-1.2h3.6c.7 0 1.2.5 1.2 1.2V11M6.5 15h15" /></>}
        {name === 'plugins' && <><path d="M11 7v4M17 7v4M9 11h10v3a5 5 0 0 1-10 0zM14 19v3" /></>}
        {name === 'cv' && <><path d="M10 6.5h6l3.5 3.5v11.5h-9.5z" /><path d="M16 6.5V10h3.5M12.5 15h5M12.5 18h3.5" /></>}
        {name === 'bug' && <><ellipse cx="14" cy="15.5" rx="4" ry="5" fill={ink} stroke="none" /><path d="M14 10.5V20.5" stroke={bottom} /><path d="M10 13H7M21 13h-3M10 17H7M21 17h-3M11.5 9l-1.5-2M16.5 9l1.5-2" /></>}
        {name === 'portrait' && <><circle cx="14" cy="11.5" r="3.2" /><path d="M8 21c1.2-3.3 3.4-4.6 6-4.6s4.8 1.3 6 4.6" /></>}
        {name === 'certificates' && <><circle cx="14" cy="12" r="4.5" fill={ink} stroke="none" /><path d="M11.2 15.5 10 21.5l4-2 4 2-1.2-6" /><circle cx="14" cy="12" r="2" fill={bottom} stroke="none" /></>}
        {name === 'mail' && <><rect x="6.5" y="9" width="15" height="11" rx="2" /><path d="M7 10l7 5.2 7-5.2" /></>}
      </g>
    )
  }
</svg>

<style>
  .app-icon {
    display: block;
    flex: none;
    filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.28));
  }
</style>

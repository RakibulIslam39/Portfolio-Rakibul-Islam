---
/* A laptop showing a Google Sheet of WooCommerce orders, with a terminal of the passing run on top. */
const rows = [
  ['#1042', 'Processing', 'Synced'],
  ['#1043', 'Completed', 'Synced'],
  ['#1044', 'On hold', 'Synced'],
  ['#1045', 'Completed', 'Synced'],
  ['#1046', 'Refunded', 'Synced'],
];
---

<div class="fo" aria-hidden="true">
  <div class="fo__laptop">
    <div class="fo__screen">
      <div class="fo__bar"><i></i><i></i><i></i><span>Orders · Google Sheets</span></div>
      <div class="fo__grid">
        <span class="fo__h">Order</span><span class="fo__h">Status</span><span class="fo__h">Sync</span>
        {rows.map((r) => r.map((c, j) => <span class:list={{ fo__ok: j === 2 }}>{c}</span>))}
      </div>
    </div>
    <div class="fo__base"></div>
  </div>
  <div class="fo__term">
    <p><b>$</b> npx playwright test</p>
    <p class="fo__pass">✓ 38 passed (2.4m)</p>
  </div>
</div>

<style>
  .fo {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 16 / 11;
  }
  .fo__laptop {
    position: absolute;
    inset: 0 0 10% 0;
  }
  .fo__screen {
    position: absolute;
    inset: 0 6% 8% 6%;
    border-radius: 12px 12px 4px 4px;
    border: 8px solid #1d1d1f;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.45);
  }
  .fo__bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 8px;
    background: #188038;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
  }
  .fo__bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.55);
  }
  .fo__bar span {
    margin-left: 6px;
  }
  .fo__grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr 1fr;
    font-size: 10px;
    color: #202124;
  }
  .fo__grid span {
    padding: 5px 8px;
    border-bottom: 1px solid #e3e3e3;
    border-right: 1px solid #e3e3e3;
    white-space: nowrap;
  }
  .fo__h {
    background: #f1f3f4;
    font-weight: 700;
  }
  .fo__ok {
    color: #188038;
    font-weight: 600;
  }
  .fo__base {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3%;
    height: 6%;
    border-radius: 0 0 14px 14px;
    background: linear-gradient(#d9d9de, #a9a9b0);
  }
  .fo__term {
    position: absolute;
    right: -2%;
    bottom: 0;
    width: 58%;
    padding: 10px 12px;
    border-radius: 10px;
    background: #101012;
    color: #d6d6dc;
    font: 500 11px/1.6 var(--font-mono);
    box-shadow: 0 16px 30px -12px rgb(0 0 0 / 0.55);
  }
  .fo__term p {
    margin: 0;
  }
  .fo__term b {
    color: #8e8e98;
  }
  .fo__pass {
    color: #3ee08f;
    font-weight: 700;
  }
</style>

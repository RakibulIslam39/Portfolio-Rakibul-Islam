---
/* A results chart: real freeway flow vs the stacked-autoencoder forecast, with the three models compared. */
const real = [42, 38, 35, 40, 55, 78, 96, 104, 98, 86, 80, 84, 92, 100, 95, 82, 70, 64];
const pred = [44, 39, 36, 41, 53, 75, 93, 102, 99, 88, 81, 83, 90, 98, 96, 84, 72, 63];
const W = 300;
const H = 120;
const pts = (a: number[]) => a.map((v, i) => `${((i / (a.length - 1)) * W).toFixed(1)},${(H - (v / 110) * H).toFixed(1)}`).join(' ');
---

<div class="tf" aria-hidden="true">
  <div class="tf__card">
    <p class="tf__title">Traffic flow · 5-minute readings</p>
    <svg viewBox={`0 0 ${W} ${H}`} class="tf__chart" preserveAspectRatio="none">
      <polyline points={pts(real)} class="tf__real"></polyline>
      <polyline points={pts(pred)} class="tf__pred"></polyline>
    </svg>
    <p class="tf__legend"><span class="tf__k tf__k--real"></span> Real <span class="tf__k tf__k--pred"></span> Predicted (SAEs)</p>
  </div>
  <ul class="tf__models">
    <li><span>LSTM</span><b style="--w: 86%"></b></li>
    <li><span>GRU</span><b style="--w: 89%"></b></li>
    <li class="is-best"><span>SAEs</span><b style="--w: 94%"></b><em>R² 0.94</em></li>
  </ul>
</div>

<style>
  .tf {
    width: 100%;
    max-width: 380px;
    display: grid;
    gap: 10px;
  }
  .tf__card,
  .tf__models {
    border-radius: 14px;
    background: rgb(255 255 255 / 0.1);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.16) inset;
    backdrop-filter: none;
  }
  .tf__card {
    padding: 12px 14px;
  }
  .tf__title {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 600;
    color: rgb(255 255 255 / 0.8);
  }
  .tf__chart {
    width: 100%;
    height: 96px;
    display: block;
  }
  .tf__chart polyline {
    fill: none;
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .tf__real {
    stroke: rgb(255 255 255 / 0.55);
  }
  .tf__pred {
    stroke: #ffd60a;
    stroke-dasharray: 5 4;
  }
  .tf__legend {
    margin: 8px 0 0;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: rgb(255 255 255 / 0.8);
  }
  .tf__k {
    width: 14px;
    height: 3px;
    border-radius: 2px;
    margin-left: 6px;
  }
  .tf__k--real {
    margin-left: 0;
    background: rgb(255 255 255 / 0.55);
  }
  .tf__k--pred {
    background: #ffd60a;
  }
  .tf__models {
    list-style: none;
    margin: 0;
    padding: 10px 14px;
    display: grid;
    gap: 6px;
    font-size: 11px;
    color: #fff;
  }
  .tf__models li {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 8px;
  }
  .tf__models b {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.7) var(--w), rgb(255 255 255 / 0.15) var(--w));
  }
  .tf__models .is-best b {
    background: linear-gradient(90deg, #ffd60a var(--w), rgb(255 255 255 / 0.15) var(--w));
  }
  .tf__models em {
    font-style: normal;
    font-weight: 700;
    color: #ffd60a;
  }
</style>

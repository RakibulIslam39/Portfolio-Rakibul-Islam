---
import site from '../content/site.json';
const year = new Date().getFullYear();
---

<footer class="footer container">
  <div class="footer__about">
    <p class="footer__name">{site.name}</p>
    <p>{site.role} · {site.location}</p>
    <p>
      Built with Astro, tested with Playwright on every push.{' '}
      <a href="/qa/">See this site's QA report</a>.
    </p>
    <a class="footer__live tap" href="/qa/" data-visitors hidden><span class="dot" aria-hidden="true"></span> <span data-visitors-text></span></a>
  </div>
  <nav class="footer__col" aria-label="Pages">
    <p class="footer__head">Pages</p>
    <ul>
      <li><a class="tap" href="/about/">About</a></li>
      <li><a class="tap" href="/projects/">Projects</a></li>
      <li><a class="tap" href="/writing/">Blog</a></li>
      <li><a class="tap" href="/certificates/">Certificates</a></li>
      <li><a class="tap" href="/cv/">CV</a></li>
    </ul>
  </nav>
  <nav class="footer__col" aria-label="Elsewhere">
    <p class="footer__head">Elsewhere</p>
    <ul>
      <li><a class="tap" href={`mailto:${site.email}`}>Email</a></li>
      <li><a class="tap" href={site.links.github} rel="me noopener" target="_blank">GitHub</a></li>
      <li><a class="tap" href={site.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      <li><a class="tap" href={site.links.medium} rel="me noopener" target="_blank">Medium</a></li>
      <li><a class="tap" href={site.links.wordpress} rel="me noopener" target="_blank">WordPress.org</a></li>
    </ul>
  </nav>
  <p class="footer__copy">© {year} {site.name}</p>
</footer>

<script>
  import { getJSON, type Stats } from '../scripts/live';
  const link = document.querySelector<HTMLAnchorElement>('[data-visitors]');
  if (link) {
    void getJSON<Stats>('/api/stats').then((s) => {
      if (!s) return;
      link.querySelector('[data-visitors-text]')!.textContent = `${s.today} visitors today · ${s.countries} countries this week`;
      link.hidden = false;
    });
  }
</script>

<style>
  .footer {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px 40px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }
  .footer p {
    margin: 0 0 6px;
  }
  .footer__name {
    color: var(--text);
    font-weight: 600;
    font-size: 16px;
  }
  .footer a {
    color: var(--muted);
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer__about a {
    color: var(--body-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer__head {
    color: var(--text);
    font-weight: 600;
  }
  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__col .tap {
    min-height: 36px;
  }
  .footer__live {
    gap: 6px;
    text-decoration: none !important;
  }
  .footer__live .dot {
    width: 6px;
    height: 6px;
    box-shadow: none;
  }
  .footer__copy {
    grid-column: 1 / -1;
    font-size: 13px;
  }
  @media (max-width: 699px) {
    .footer {
      grid-template-columns: 1fr 1fr;
      padding-bottom: 120px;
    }
    .footer__about {
      grid-column: 1 / -1;
    }
    .footer__col .tap {
      min-height: var(--tap);
    }
  }
</style>

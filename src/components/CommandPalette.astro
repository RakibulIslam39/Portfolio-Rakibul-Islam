---
import site from '../content/site.json';

type Item = { label: string; hint: string; group: string; href?: string; action?: string };

const items: Item[] = [
  { group: 'Pages', label: 'Home', hint: '/', href: '/' },
  { group: 'Pages', label: 'About', hint: '/about/', href: '/about/' },
  { group: 'Pages', label: 'Projects', hint: '/projects/', href: '/projects/' },
  { group: 'Pages', label: 'Writing', hint: '/writing/', href: '/writing/' },
  { group: 'Pages', label: 'QA report', hint: '/qa/', href: '/qa/' },
  { group: 'Pages', label: 'CV', hint: '/cv/', href: '/cv/' },
  ...site.projects.map((p) => ({ group: 'Projects', label: p.name, hint: p.hook, href: `/projects/${p.slug}/` })),
  { group: 'Links', label: 'GitHub', hint: 'github.com', href: site.links.github },
  { group: 'Links', label: 'LinkedIn', hint: 'linkedin.com', href: site.links.linkedin },
  { group: 'Links', label: 'Download CV', hint: 'PDF', href: '/Rakibul-Islam-CV.pdf' },
  { group: 'Actions', label: 'Copy email address', hint: site.email, action: 'copy-email' },
  { group: 'Actions', label: 'Toggle dark / light theme', hint: 'Theme', action: 'toggle-theme' },
];
---

<dialog class="palette" aria-label="Search the site" data-palette data-email={site.email}>
  <div class="palette__box">
    <label class="palette__search">
      <span class="sr-only">Search pages, projects and actions</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <input
        type="text"
        placeholder="Search pages, projects, actions…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        data-palette-input
      />
      <kbd>esc</kbd>
    </label>
    <ul id="palette-list" class="palette__list" role="listbox" aria-label="Results">
      {
        items.map((item, i) => (
          <li
            id={`palette-opt-${i}`}
            role="option"
            aria-selected="false"
            data-palette-item
            data-label={`${item.label} ${item.hint} ${item.group}`.toLowerCase()}
            data-href={item.href}
            data-action={item.action}
          >
            <span class="palette__group">{item.group}</span>
            <span class="palette__label">{item.label}</span>
            <span class="palette__hint">{item.hint}</span>
          </li>
        ))
      }
    </ul>
    <p class="palette__empty" data-palette-empty hidden>No results. Try “playwright” or “cv”.</p>
    <p class="palette__status sr-only" aria-live="polite" data-palette-status></p>
  </div>
</dialog>

<style>
  .palette {
    width: min(100% - 32px, 560px);
    max-height: min(70vh, 520px);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--tile-edge);
    border-radius: 20px;
    background: var(--glass);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
    color: var(--text);
    overflow: hidden;
  }
  .palette[open] {
    animation: pop 0.22s var(--ease-arrive);
  }
  .palette::backdrop {
    background: rgba(0, 0, 0, 0.35);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(-6px);
    }
  }
  .palette__search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .palette__search input {
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--text);
    font: 500 16px var(--font);
    outline: none;
  }
  .palette__search kbd {
    font-size: 11px;
    border: 1px solid var(--outline);
    border-radius: 6px;
    padding: 1px 6px;
  }
  .palette__list {
    list-style: none;
    margin: 0;
    padding: 8px;
    max-height: 380px;
    overflow-y: auto;
  }
  .palette__list li {
    display: grid;
    grid-template-columns: 76px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 14px;
  }
  .palette__list li[aria-selected='true'] {
    background: var(--link);
    color: #fff;
  }
  .palette__list li[aria-selected='true'] .palette__group,
  .palette__list li[aria-selected='true'] .palette__hint {
    color: rgba(255, 255, 255, 0.8);
  }
  .palette__group {
    font-size: 12px;
    color: var(--muted);
  }
  .palette__label {
    font-weight: 500;
  }
  .palette__hint {
    font-size: 12px;
    color: var(--muted);
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .palette__empty {
    padding: 20px;
    margin: 0;
    color: var(--muted);
    text-align: center;
  }
</style>

<script>
  import { initPalette } from '../scripts/palette';
  initPalette();
</script>

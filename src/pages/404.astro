---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppIcon from '../components/AppIcon.astro';

/* 404, styled as Find My looking for a lost device: the map searches, then gives up and offers
 * the places that do exist. The streets are the same OpenStreetMap picture as the home tile. */
const places = [
  { href: '/', label: 'Home', sub: 'Start from the top', icon: 'portrait' },
  { href: '/projects/', label: 'Projects', sub: 'Case studies and repos', icon: 'projects' },
  { href: '/writing/', label: 'Blog', sub: 'Posts on Medium', icon: 'blog' },
  { href: '/certificates/', label: 'Certificates', sub: '6 courses', icon: 'certificates' },
] as const;
---

<BaseLayout title="404 | Rakibul Islam" description="This page doesn't exist. Here are the ones that do.">
  <div class="container lost">
    <section class="lost__tile" data-lost>
      <div class="lost__map" aria-hidden="true">
        <img class="lost__img lost__img--dark" src="/findmy/dark.svg" width="500" height="500" alt="" />
        <img class="lost__img lost__img--light" src="/findmy/light.svg" width="500" height="500" alt="" />
        <span class="lost__ring"></span>
        <span class="lost__ring lost__ring--2"></span>
        <span class="lost__pin">?</span>
      </div>

      <div class="lost__sheet">
        <p class="lost__status" data-lost-status>
          <span class="lost__spinner" aria-hidden="true"></span>
          <span data-lost-text>Locating this page…</span>
        </p>
        <h1 class="lost__title">404: this page doesn't exist</h1>
        <p class="lost__lede">
          Expected a page here, received nothing. Test failed, and that one's on me. Try one of these, or press
          <kbd>⌘K</kbd> to search.
        </p>
        <ul class="lost__places">
          {
            places.map((p) => (
              <li>
                <a href={p.href}>
                  <AppIcon name={p.icon} size={32} />
                  <span>
                    <strong>{p.label}</strong>
                    <span>{p.sub}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .lost {
    padding-bottom: 48px;
  }
  .lost__tile {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    min-height: 520px;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
  }
  .lost__map {
    position: relative;
    min-height: 320px;
    overflow: hidden;
  }
  .lost__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lost__img--light,
  :global([data-theme='light']) .lost__img--dark {
    display: none;
  }
  :global([data-theme='light']) .lost__img--light {
    display: block;
  }
  .lost__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 280px;
    height: 280px;
    margin: -140px 0 0 -140px;
    border-radius: 50%;
    border: 2px solid rgb(58 139 255 / 0.6);
    background: radial-gradient(rgb(58 139 255 / 0.18), transparent 70%);
    animation: search 2.4s var(--ease-travel) infinite;
  }
  .lost__ring--2 {
    animation-delay: 1.2s;
  }
  @keyframes search {
    from {
      transform: scale(0.2);
      opacity: 1;
    }
    to {
      transform: scale(1);
      opacity: 0;
    }
  }
  .lost__pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 3px solid #fff;
    background: #8e8e93;
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.4);
  }
  [data-lost].is-lost .lost__ring {
    animation-iteration-count: 1;
    animation-fill-mode: forwards;
  }
  .lost__sheet {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px clamp(22px, 3vw, 36px);
  }
  .lost__status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .lost__spinner {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--line);
    border-top-color: var(--link);
    animation: spin 0.9s linear infinite;
  }
  [data-lost].is-lost .lost__spinner {
    animation: none;
    border-color: #ff453a;
    background: #ff453a;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .lost__title {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .lost__lede {
    margin: 0;
    max-width: 44ch;
  }
  .lost__lede kbd {
    padding: 1px 6px;
    border-radius: 6px;
    border: 1px solid var(--line);
    font: 600 12px var(--font-mono);
  }
  .lost__places {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .lost__places a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tap);
    padding: 8px 10px;
    border-radius: 12px;
    text-decoration: none;
  }
  .lost__places a:hover {
    background: var(--hover);
  }
  .lost__places a > span {
    display: grid;
    line-height: 1.3;
  }
  .lost__places strong {
    color: var(--text);
    font-size: 15px;
  }
  .lost__places a > span > span {
    color: var(--muted);
    font-size: 13px;
  }
  @media (max-width: 799px) {
    .lost__tile {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lost__ring,
    .lost__spinner {
      animation: none;
    }
  }
</style>

<script>
  // Search for a moment, then give up like Find My does.
  const tile = document.querySelector<HTMLElement>('[data-lost]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const giveUp = () => {
    tile?.classList.add('is-lost');
    const text = tile?.querySelector('[data-lost-text]');
    if (text) text.textContent = 'No location found';
  };
  if (reduce) giveUp();
  else window.setTimeout(giveUp, 1800);
</script>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length]! },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<BaseLayout title={`${d.title} | Rakibul Islam`} description={d.summary}>
  <article class="container case">
    <a class="back-link tap" href="/projects/">← All projects</a>

    <header class="page-head">
      <div class="case__title">
        <h1>{d.title}</h1>
        {d.placeholder && <span class="draft-badge">Draft</span>}
      </div>
      <p>{d.summary}</p>
      <p class="case__hook">{d.hook}</p>
    </header>

    <dl class="case__meta">
      <div><dt>Role</dt><dd>{d.role}</dd></div>
      <div><dt>When</dt><dd>{d.period}</dd></div>
      <div><dt>Context</dt><dd>{d.context}</dd></div>
      {
        d.links.length > 0 && (
          <div>
            <dt>Links</dt>
            <dd class="case__links">
              {d.links.map((l) => (
                <a href={l.url} target="_blank" rel="noopener">
                  {l.label} ↗
                </a>
              ))}
            </dd>
          </div>
        )
      }
    </dl>

    {
      d.metrics.length > 0 && (
        <ul class="case__metrics" aria-label="Results">
          {d.metrics.map((m) => (
            <li>
              <strong>{m.value}</strong> {m.label}
            </li>
          ))}
        </ul>
      )
    }

    <div class="case__layout">
      <div class="prose">
        <Content />
      </div>
      <aside class="case__stack" aria-label="Tech stack">
        <h2>Stack</h2>
        <ul>{d.stack.map((s) => <li class="pill">{s}</li>)}</ul>
      </aside>
    </div>

    <nav class="case__next" aria-label="Next project">
      <span>Next project</span>
      <a href={`/projects/${next.id}/`}>{next.data.title} →</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .case {
    padding-bottom: 48px;
  }
  .case__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-bottom: 14px;
  }
  .case__title :global(h1) {
    margin-bottom: 0 !important;
  }
  .case__hook {
    margin-top: 12px !important;
    font-size: 16px !important;
    font-weight: 600;
    color: var(--pass);
  }
  .case__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px 32px;
    margin: 0 0 28px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .case__meta dt {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .case__meta dd {
    margin: 0;
    color: var(--text);
    font-size: 15px;
  }
  .case__links {
    display: flex;
    flex-direction: column;
  }
  .case__links a {
    color: var(--link);
    text-decoration: none;
    padding: 10px 0;
    margin: -10px 0;
  }
  .case__links a + a {
    margin-top: 0;
  }
  .case__links a:hover {
    text-decoration: underline;
  }
  .case__metrics {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-size: 15px;
    color: var(--muted);
  }
  .case__metrics strong {
    color: var(--pass);
    font-size: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    margin-right: 4px;
  }
  .case__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 48px;
    align-items: start;
  }
  .case__stack {
    position: sticky;
    top: 96px;
  }
  .case__stack h2 {
    font-size: 15px;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .case__stack ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .case__next {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }
  .case__next a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text);
    font-size: 20px;
    font-weight: 600;
    text-decoration: none;
  }
  .case__next a:hover {
    text-decoration: underline;
  }
  @media (max-width: 899px) {
    .case__layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .case__stack {
      position: static;
      order: -1;
    }
  }
</style>

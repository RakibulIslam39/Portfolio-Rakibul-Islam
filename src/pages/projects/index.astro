---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../content/site.json';
import AppIcon from '../../components/AppIcon.astro';
import { projectLook } from '../../lib/projects';
import FlexOrderMock from '../../components/mockups/FlexOrderMock.astro';
import TrafficMock from '../../components/mockups/TrafficMock.astro';
import FaceMock from '../../components/mockups/FaceMock.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(site.repos.map((r) => r.group))].map((g) => ({
  name: g,
  repos: site.repos.filter((r) => r.group === g).sort((a, b) => b.updated.localeCompare(a.updated)),
}));
const today = projectLook;
const companyColor: Record<string, string> = { WPPOOL: '#3a6df0', 'Zaimah Technologies': '#0f9e66', Edutechs: '#1aa7ec' };
const month = (ym: string) =>
  new Date(`${ym}-01T00:00:00Z`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Projects | Rakibul Islam" description="Test automation frameworks, CI pipelines and side projects by Rakibul Islam.">
  <div class="container">
    <header class="page-head store-head">
      <div>
        <p class="store-head__eyebrow">Test frameworks, pipelines and side projects</p>
        <h1>Projects</h1>
        <p>Each one has a short case study: the problem, what I built and how it turned out.</p>
      </div>
      <a class="store-head__me" href="/about/" aria-label={`About ${site.firstName}`}>
        <img data-me src="/portrait/photo-192.webp" data-photo="/portrait/photo-192.webp" data-avatar="/portrait/avatar-192.webp" width="40" height="40" alt="" decoding="async" />
      </a>
    </header>

    <ul class="plist">
      {
        projects.map((p, i) => {
          const card = today[p.id]!;
          return (
            <li class:list={['today', `today--${card.tone}`, { 'today--lead': i === 0 }]}>
              <div class="today__top">
                <p class="today__eyebrow">{card.eyebrow}</p>
                <h2 class="today__headline">{card.headline}</h2>
              </div>
              <div class="today__art">
                {card.mock === 'flexorder' && <FlexOrderMock />}
                {card.mock === 'traffic' && <TrafficMock />}
                {card.mock === 'face' && <FaceMock />}
              </div>
              <div class="today__strip">
                <AppIcon name={card.icon} size={40} />
                <span class="today__app">
                  <strong>{p.data.title}</strong>
                  <span>{p.data.hook}</span>
                </span>
                <a class="today__get" href={`/projects/${p.id}/`}>
                  View<span class="sr-only"> the {p.data.title} case study</span>
                </a>
              </div>
            </li>
          );
        })
      }
      <li class="today today--work">
        <div class="today__top">
          <p class="today__eyebrow">Experience</p>
          <h2 class="today__headline">Where I've tested</h2>
        </div>
        <ul class="work">
          {
            site.experience.map((e) => (
              <li>
                <span class="work__icon" style={`--c:${companyColor[e.company] ?? '#8e8e93'}`} aria-hidden="true">
                  {e.company.slice(0, 1)}
                </span>
                <span class="work__text">
                  <strong>{e.company}</strong>
                  <span>
                    {e.role} · {e.period}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
        <a class="today__get today__get--wide" href="/about/">Read more about my experience</a>
      </li>
    </ul>

    <section class="repos" aria-labelledby="repos-title">
      <header class="repos__head">
        <h2 id="repos-title" class="repos__title"><AppIcon name="github" size={36} />All GitHub repositories</h2>
        <p>
          Every public repository on my GitHub, {site.repos.length} in total.
          <a href={`${site.links.github}?tab=repositories`} target="_blank" rel="noopener">Open my GitHub profile ↗</a>
        </p>
      </header>
      {
        groups.map((g) => (
          <div class="repos__group">
            <h3 class="repos__group-title">
              {g.name} <span>{g.repos.length}</span>
            </h3>
            <ul class="rlist">
              {g.repos.map((r) => (
                <li class="rcard" data-repo={r.name}>
                  <h4 class="rcard__name">
                    <a href={r.url} target="_blank" rel="noopener">
                      {r.name}
                      <span class="sr-only"> on GitHub</span>
                    </a>
                  </h4>
                  <p class="rcard__desc">{r.description}</p>
                  <p class="rcard__meta">
                    <span class="rcard__lang" data-lang={r.language}>
                      {r.language}
                    </span>
                    <span>Updated {month(r.updated)}</span>
                    {r.case && (
                      <a class="rcard__case" href={r.case}>
                        Case study<span class="sr-only">: {r.name}</span>
                      </a>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .store-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .store-head__eyebrow {
    margin: 0 0 4px !important;
    font-size: 13px !important;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .store-head__me {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    margin-bottom: 8px;
  }
  .store-head__me img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }
  /* App Store "Today" cards */
  .plist {
    list-style: none;
    margin: 0 0 56px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  .today {
    --fg: #1d1d1f;
    --sub: rgb(29 29 31 / 0.62);
    --strip: rgb(255 255 255 / 0.55);
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 460px;
    border-radius: 24px;
    overflow: hidden;
    color: var(--fg);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
    transition: transform 0.35s var(--ease-arrive), box-shadow 0.35s;
  }
  .today:hover {
    transform: translateY(-4px) scale(1.005);
    box-shadow: 0 0 0 1px var(--tile-edge) inset, 0 24px 50px -24px rgb(0 0 0 / 0.45);
  }
  .today--lead {
    grid-column: span 2;
  }
  .today--mint {
    background: linear-gradient(160deg, #d8f7e6, #b8ecd0);
  }
  .today--indigo {
    --fg: #fff;
    --sub: rgb(255 255 255 / 0.72);
    --strip: rgb(0 0 0 / 0.25);
    background: linear-gradient(160deg, #3446c7, #1b2477);
  }
  .today--lilac {
    background: linear-gradient(160deg, #f6dcff, #e3c4ff);
  }
  .today--work {
    background: var(--tile);
    --fg: var(--text);
    --sub: var(--muted);
    grid-column: span 2;
    min-height: 0;
  }
  .today__top {
    padding: 26px 28px 0;
  }
  .today__eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sub);
  }
  .today__headline {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--fg);
  }
  .today__art {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 22px 28px;
  }
  .today__strip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    background: var(--strip);
  }
  .today__app {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }
  .today__app strong {
    font-size: 15px;
    color: var(--fg);
  }
  .today__app span {
    font-size: 13px;
    color: var(--sub);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .today__get {
    margin-left: auto;
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 18px;
    border-radius: 999px;
    background: rgb(118 118 128 / 0.2);
    color: #0a63d6;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .today--indigo .today__get {
    background: rgb(255 255 255 / 0.9);
  }
  /* The whole card is the link's hit area. */
  .today__get::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .today__get:focus-visible {
    outline: none;
  }
  .today:has(.today__get:focus-visible) {
    outline: 3px solid var(--link);
    outline-offset: 3px;
  }
  .today__get--wide {
    margin: 0 28px 26px;
    align-self: flex-start;
    color: var(--text);
    background: var(--hover);
  }
  .work {
    list-style: none;
    margin: 0;
    padding: 18px 28px 20px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 14px;
  }
  .work li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .work__icon {
    width: 44px;
    height: 44px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 22.5%;
    background: var(--c);
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.18) inset, 0 1px 2px rgb(0 0 0 / 0.25);
  }
  .work__text {
    display: grid;
    line-height: 1.3;
  }
  .work__text strong {
    font-size: 15px;
    color: var(--text);
  }
  .work__text span {
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 1023px) {
    .plist {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 699px) {
    .plist {
      grid-template-columns: 1fr;
    }
    .today--lead,
    .today--work {
      grid-column: auto;
    }
    .today {
      min-height: 420px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .today,
    .today:hover {
      transition: none;
      transform: none;
    }
  }
  .repos {
    margin-bottom: 64px;
  }
  .repos__head {
    margin-bottom: 20px;
  }
  .repos__head .repos__title {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .repos__head h2 {
    font-size: clamp(28px, 4vw, 36px);
    letter-spacing: -0.025em;
    margin: 0 0 8px;
  }
  .repos__head p {
    margin: 0;
    color: var(--muted);
  }
  .repos__head a {
    color: var(--text);
    font-weight: 600;
  }
  .repos__group + .repos__group {
    margin-top: 32px;
  }
  .repos__group-title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 18px;
    margin: 0 0 12px;
  }
  .repos__group-title span {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  .rlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--gap);
  }
  .rcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
    transition: box-shadow 0.3s;
  }
  .rcard:hover {
    box-shadow: 0 0 0 1px var(--outline) inset, var(--shadow);
  }
  .rcard__name {
    margin: 0;
    font-size: 17px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .rcard__name a {
    color: var(--text);
    text-decoration: none;
  }
  .rcard__name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .rcard__name a:focus-visible {
    outline: none;
  }
  .rcard:has(.rcard__name a:focus-visible) {
    outline: 2px solid var(--focus, var(--text));
    outline-offset: 2px;
  }
  .rcard__desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .rcard__meta {
    margin: auto 0 0;
    padding-top: 6px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-size: 13px;
    color: var(--muted);
  }
  .rcard__lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text);
  }
  .rcard__lang::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--muted);
  }
  .rcard__lang[data-lang='TypeScript']::before { background: #3178c6; }
  .rcard__lang[data-lang='JavaScript']::before { background: #e0c300; }
  .rcard__lang[data-lang='Python']::before { background: #3572a5; }
  .rcard__lang[data-lang='Astro']::before { background: #ff5a03; }
  .rcard__lang[data-lang='HTML']::before { background: #e34c26; }
  .rcard__case {
    position: relative;
    z-index: 1;
    margin-left: auto;
    color: var(--text);
    font-weight: 600;
    display: inline-block;
    line-height: 24px;
  }
</style>

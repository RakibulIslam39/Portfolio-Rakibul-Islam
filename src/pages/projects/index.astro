---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../content/site.json';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(site.repos.map((r) => r.group))].map((g) => ({
  name: g,
  repos: site.repos.filter((r) => r.group === g).sort((a, b) => b.updated.localeCompare(a.updated)),
}));
const month = (ym: string) =>
  new Date(`${ym}-01T00:00:00Z`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Projects | Rakibul Islam" description="Test automation frameworks, CI pipelines and side projects by Rakibul Islam.">
  <div class="container">
    <header class="page-head">
      <h1>Projects</h1>
      <p>Test frameworks, pipelines and a few side projects. Each one has a short case study: the problem, what I built and how it turned out.</p>
    </header>

    <ul class="plist">
      {
        projects.map((p, i) => (
          <li class:list={['pcard', { 'pcard--lead': i === 0 }]}>
            <a href={`/projects/${p.id}/`} class="pcard__link">
              <h2 class="pcard__title">{p.data.title}</h2>
              <span class="pcard__hook">{p.data.hook}</span>
              <p class="pcard__summary">{p.data.summary}</p>
              <span class="pcard__stack">
                {p.data.stack.slice(0, 5).map((s) => (
                  <span class="pill">{s}</span>
                ))}
              </span>
              <span class="pcard__cta" aria-hidden="true">
                Read case study →
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <section class="repos" aria-labelledby="repos-title">
      <header class="repos__head">
        <h2 id="repos-title">All GitHub repositories</h2>
        <p>
          Every public repository on my GitHub, {site.repos.length} in total.
          <a href={`${site.links.github}?tab=repositories`} target="_blank" rel="noopener">Open my GitHub profile ↗</a>
        </p>
      </header>
      {
        groups.map((g) => (
          <div class="repos__group">
            <h3 class="repos__group-title">
              {g.name} <span>{g.repos.length}</span>
            </h3>
            <ul class="rlist">
              {g.repos.map((r) => (
                <li class="rcard" data-repo={r.name}>
                  <h4 class="rcard__name">
                    <a href={r.url} target="_blank" rel="noopener">
                      {r.name}
                      <span class="sr-only"> on GitHub</span>
                    </a>
                  </h4>
                  <p class="rcard__desc">{r.description}</p>
                  <p class="rcard__meta">
                    <span class="rcard__lang" data-lang={r.language}>
                      {r.language}
                    </span>
                    <span>Updated {month(r.updated)}</span>
                    {r.case && (
                      <a class="rcard__case" href={r.case}>
                        Case study<span class="sr-only">: {r.name}</span>
                      </a>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .plist {
    list-style: none;
    margin: 0 0 48px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
  }
  .pcard--lead {
    grid-column: 1 / -1;
  }
  .pcard__link {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: var(--tile-pad);
    border-radius: var(--radius);
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
    text-decoration: none;
    transition: transform 0.3s var(--ease-arrive), box-shadow 0.3s;
  }
  .pcard__link:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 0 1px var(--outline) inset, var(--shadow);
  }
  .pcard__hook {
    font-size: 15px;
    font-weight: 600;
    color: var(--pass);
  }
  .pcard__title {
    font-size: 28px;
    letter-spacing: -0.025em;
  }
  .pcard--lead .pcard__title {
    font-size: clamp(30px, 4vw, 40px);
  }
  .pcard__summary {
    margin: 0;
    max-width: 62ch;
  }
  .pcard__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin: 8px 0 4px;
  }
  .pcard__metrics div {
    display: flex;
    flex-direction: column-reverse;
  }
  .pcard__metrics dt {
    font-size: 13px;
    color: var(--muted);
  }
  .pcard__metrics dd {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .pcard__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pcard__stack .pill {
    font-size: 12px;
  }
  .pcard__cta {
    margin-top: auto;
    padding-top: 8px;
    font-weight: 600;
    font-size: 14px;
    color: var(--text);
  }
  .repos {
    margin-bottom: 64px;
  }
  .repos__head {
    margin-bottom: 20px;
  }
  .repos__head h2 {
    font-size: clamp(28px, 4vw, 36px);
    letter-spacing: -0.025em;
    margin: 0 0 8px;
  }
  .repos__head p {
    margin: 0;
    color: var(--muted);
  }
  .repos__head a {
    color: var(--text);
    font-weight: 600;
  }
  .repos__group + .repos__group {
    margin-top: 32px;
  }
  .repos__group-title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 18px;
    margin: 0 0 12px;
  }
  .repos__group-title span {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  .rlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--gap);
  }
  .rcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
    transition: box-shadow 0.3s;
  }
  .rcard:hover {
    box-shadow: 0 0 0 1px var(--outline) inset, var(--shadow);
  }
  .rcard__name {
    margin: 0;
    font-size: 17px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .rcard__name a {
    color: var(--text);
    text-decoration: none;
  }
  .rcard__name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .rcard__name a:focus-visible {
    outline: none;
  }
  .rcard:has(.rcard__name a:focus-visible) {
    outline: 2px solid var(--focus, var(--text));
    outline-offset: 2px;
  }
  .rcard__desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .rcard__meta {
    margin: auto 0 0;
    padding-top: 6px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-size: 13px;
    color: var(--muted);
  }
  .rcard__lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text);
  }
  .rcard__lang::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--muted);
  }
  .rcard__lang[data-lang='TypeScript']::before { background: #3178c6; }
  .rcard__lang[data-lang='JavaScript']::before { background: #e0c300; }
  .rcard__lang[data-lang='Python']::before { background: #3572a5; }
  .rcard__lang[data-lang='Astro']::before { background: #ff5a03; }
  .rcard__lang[data-lang='HTML']::before { background: #e34c26; }
  .rcard__case {
    position: relative;
    z-index: 1;
    margin-left: auto;
    color: var(--text);
    font-weight: 600;
    display: inline-block;
    line-height: 24px;
  }
  @media (max-width: 699px) {
    .plist {
      grid-template-columns: 1fr;
    }
  }
</style>

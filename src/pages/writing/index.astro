---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime, slugify } from '../../lib/format';
import site from '../../content/site.json';
import AppIcon from '../../components/AppIcon.astro';

const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const counts = posts.reduce<Record<string, number>>((acc, p) => {
  acc[p.data.category] = (acc[p.data.category] ?? 0) + 1;
  return acc;
}, {});
const categories = Object.entries(counts).sort((a, b) => b[1] - a[1]);
const [latest, ...rest] = posts;
// Topics the posts cover, for the tags tile.
const topics = ['Playwright', 'Google Sheets API', 'WooCommerce REST API', 'Page Object Model', 'CI/CD', 'AI-assisted testing'];
const href = (p: (typeof posts)[number]) => p.data.url ?? `/writing/${p.id}/`;
const minutes = (p: (typeof posts)[number]) => p.data.minutes ?? readingTime(p.body ?? '');
const ext = (p: (typeof posts)[number]) => (p.data.url ? { target: '_blank', rel: 'noopener' } : {});
---

<BaseLayout title="Blog | Rakibul Islam" description="Posts by Rakibul Islam on Playwright, test automation, CI/CD and API testing.">
  <div class="container">
    <header class="page-head">
      <h1>Blog</h1>
      <p>What I learn while automating tests: Playwright, CI pipelines and API testing. I publish on <a href={site.links.medium} target="_blank" rel="noopener">Medium ↗</a>.</p>
    </header>

    {categories.length > 1 && (
    <div class="chips" role="group" aria-label="Filter by category" data-filter>
      <button type="button" class="chip" aria-pressed="true" data-cat="all">All <b>{posts.length}</b></button>
      {
        categories.map(([cat, n]) => (
          <button type="button" class="chip" aria-pressed="false" data-cat={slugify(cat)}>
            {cat} <b>{n}</b>
          </button>
        ))
      }
    </div>
    )}
    <p class="sr-only" aria-live="polite" data-filter-status></p>

    <div class="wr-grid">
      {
        latest && (
          <a class="featured" href={href(latest)} {...ext(latest)} data-post data-cat={slugify(latest.data.category)}>
            <span class="featured__meta">
              Latest · {latest.data.category} · {minutes(latest)} min read
              {latest.data.source && <span class="source">on {latest.data.source} ↗</span>}
              {latest.data.placeholder && <span class="draft-badge">Draft</span>}
            </span>
            <h2>{latest.data.title}</h2>
            <p>{latest.data.excerpt}</p>
            <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
          </a>
        )
      }
      <figure class="wr-quote">
        <blockquote>
          <p>Automating it meant ensuring that such bulk operations never break.</p>
        </blockquote>
        <figcaption>From the FlexStock post</figcaption>
      </figure>
      <a class="wr-follow" href={site.links.medium} target="_blank" rel="noopener">
        <AppIcon name="medium" size={44} />
        <span>
          <strong>Follow on Medium</strong>
          <span>New posts land there first</span>
        </span>
      </a>
      <div class="wr-topics">
        <h2 class="wr-topics__title">Topics</h2>
        <ul>
          {topics.map((t) => <li class="pill">{t}</li>)}
        </ul>
      </div>
    </div>

    {rest.length > 0 && (
    <ul class="posts">
      {
        rest.map((p) => (
          <li data-post data-cat={slugify(p.data.category)}>
            <a href={href(p)} {...ext(p)}>
              <span class="posts__meta">
                {p.data.category} · {minutes(p)} min
                {p.data.source && <span>· {p.data.source} ↗</span>}
                {p.data.placeholder && <span class="draft-badge">Draft</span>}
              </span>
              <span class="posts__title">{p.data.title}</span>
              <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            </a>
          </li>
        ))
      }
    </ul>
    )}
    <p class="empty" data-empty hidden>No posts in this category yet.</p>
  </div>
</BaseLayout>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--tile);
    color: var(--body-text);
    font-size: 14px;
    cursor: pointer;
  }
  .chip b {
    font-weight: 600;
    color: var(--muted);
  }
  .chip:hover {
    border-color: var(--outline);
  }
  .chip[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .chip[aria-pressed='true'] b {
    color: var(--bg);
  }
  /* Tile grid: the newest post big, with a pull quote, a follow tile and topics beside it. */
  .wr-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    grid-template-areas:
      'feat quote'
      'feat follow'
      'topics topics';
    gap: var(--gap);
    margin-bottom: var(--gap);
  }
  .wr-grid .featured {
    grid-area: feat;
    margin-bottom: 0;
    align-content: end;
    min-height: 340px;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--pass) 22%, transparent), transparent 60%),
      var(--tile);
  }
  .wr-quote {
    grid-area: quote;
    margin: 0;
    padding: var(--tile-pad);
    border-radius: var(--radius);
    background: #ffd60a;
    color: #1d1d1f;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }
  .wr-quote blockquote {
    margin: 0;
  }
  .wr-quote p {
    margin: 0;
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .wr-quote p::before {
    content: '“';
  }
  .wr-quote p::after {
    content: '”';
  }
  .wr-quote figcaption {
    font-size: 13px;
    font-weight: 600;
    color: rgb(29 29 31 / 0.7);
  }
  .wr-follow {
    grid-area: follow;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: var(--tile-pad);
    border-radius: var(--radius);
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
    text-decoration: none;
    transition: transform 0.3s var(--ease-arrive);
  }
  .wr-follow:hover {
    transform: translateY(-3px);
  }
  .wr-follow > span {
    display: grid;
    line-height: 1.3;
  }
  .wr-follow strong {
    color: var(--text);
    font-size: 16px;
  }
  .wr-follow > span > span {
    color: var(--muted);
    font-size: 13px;
  }
  .wr-topics {
    grid-area: topics;
    padding: 18px var(--tile-pad);
    border-radius: var(--radius);
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
  }
  .wr-topics__title {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .wr-topics ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 799px) {
    .wr-grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'feat' 'quote' 'follow' 'topics';
    }
    .wr-grid .featured {
      min-height: 0;
    }
  }
  .featured {
    display: grid;
    gap: 10px;
    padding: var(--tile-pad);
    border-radius: var(--radius);
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
    text-decoration: none;
    margin-bottom: var(--gap);
    transition: transform 0.3s var(--ease-arrive);
  }
  .featured:hover {
    transform: translateY(-3px);
  }
  .featured h2 {
    font-size: clamp(26px, 4vw, 34px);
    letter-spacing: -0.025em;
  }
  .featured p {
    margin: 0;
    max-width: 62ch;
  }
  .featured__meta,
  .posts__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .source {
    color: var(--text);
    font-weight: 600;
  }
  .featured time,
  .posts time {
    font-size: 13px;
    color: var(--muted);
  }
  .posts {
    list-style: none;
    margin: 0 0 48px;
    padding: 0 var(--tile-pad);
    border-radius: var(--radius);
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
  }
  .posts li + li {
    border-top: 1px solid var(--line);
  }
  .posts a {
    display: grid;
    grid-template-columns: 180px 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    text-decoration: none;
  }
  .posts__title {
    color: var(--text);
    font-weight: 600;
    font-size: 17px;
  }
  .posts a:hover .posts__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .empty {
    color: var(--muted);
  }
  @media (max-width: 699px) {
    .posts a {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>

<script>
  const filter = document.querySelector<HTMLElement>('[data-filter]');
  if (filter) {
    const chips = Array.from(filter.querySelectorAll<HTMLButtonElement>('[data-cat]'));
    const posts = Array.from(document.querySelectorAll<HTMLElement>('[data-post]'));
    const status = document.querySelector<HTMLElement>('[data-filter-status]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const apply = (cat: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.cat === cat)));
      let shown = 0;
      posts.forEach((p) => {
        p.hidden = cat !== 'all' && p.dataset.cat !== cat;
        if (!p.hidden) shown++;
      });
      empty.hidden = shown > 0;
      status.textContent = `${shown} post${shown === 1 ? '' : 's'} shown`;
    };
    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.cat!)));
  }
</script>

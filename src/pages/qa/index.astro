---
import BaseLayout from '../../layouts/BaseLayout.astro';
import qa from '../../data/qa-report.json';
import { formatDate } from '../../lib/format';

const t = qa.tests;
const ran = t.total - t.skipped;
const passRate = ran ? Math.round((t.passed / ran) * 100) : 0;
const minutes = Math.floor(t.durationMs / 60000);
const seconds = Math.round((t.durationMs % 60000) / 1000);
const generated = new Date(qa.generatedAt);

const categories = [
  { key: 'performance', label: 'Performance' },
  { key: 'accessibility', label: 'Accessibility' },
  { key: 'bestPractices', label: 'Best practices' },
  { key: 'seo', label: 'SEO' },
] as const;
const grade = (n: number) => (n >= 90 ? 'good' : n >= 50 ? 'ok' : 'poor');
const avg = (k: (typeof categories)[number]['key']) =>
  qa.lighthouse.length ? Math.round(qa.lighthouse.reduce((s, r) => s + r[k], 0) / qa.lighthouse.length) : 0;

// Activity rings, like Apple Fitness: outer to inner. Each ring closes at 100%.
const passing = ran ? Math.round(((t.passed + (t.flaky ?? 0)) / ran) * 100) : 0;
const rings = [
  { label: 'Tests passing', value: passing, unit: '%', color: '#fa114f', track: 'rgb(250 17 79 / 0.22)', note: `${t.passed + (t.flaky ?? 0)} of ${ran}` },
  { label: 'Performance', value: avg('performance'), unit: '', color: '#a6ff00', track: 'rgb(166 255 0 / 0.2)', note: 'Lighthouse, average' },
  { label: 'Accessibility', value: avg('accessibility'), unit: '', color: '#00f0ff', track: 'rgb(0 240 255 / 0.2)', note: 'Lighthouse, average' },
];
const R = [84, 62, 40];
const ring = (r: number, v: number) => {
  const c = 2 * Math.PI * r;
  return { c, dash: `${((Math.min(v, 100) / 100) * c).toFixed(1)} ${c.toFixed(1)}` };
};
---

<BaseLayout title="QA report | Rakibul Islam" description="This site's own test results, Lighthouse scores and live CI status.">
  <div class="container qa">
    <header class="page-head">
      <h1>This site's QA report</h1>
      <p>
        Every push runs the full Playwright suite on {t.projects.length} browser setups, an accessibility scan and Lighthouse.
        Only a green build gets deployed.
      </p>
      <p class="qa__source">
        {
          qa.sample ? (
            <span data-qa-source>Sample data from a local run · {formatDate(generated)}</span>
          ) : (
            <span data-qa-source>
              Latest CI run · {formatDate(generated)}
              {qa.commit && <> · commit {qa.commit}</>}
            </span>
          )
        }
      </p>
    </header>


    <section class="activity" aria-labelledby="activity-h">
      <h2 id="activity-h" class="sr-only">At a glance</h2>
      <article class="card card--dark rings-card">
        <h3 class="card__label">How it scores</h3>
        <div class="rings">
          <svg viewBox="0 0 200 200" width="200" height="200" role="img" aria-label={rings.map((r) => `${r.label} ${r.value}${r.unit}`).join(', ')}>
            {
              rings.map((r, i) => {
                const g = ring(R[i]!, r.value);
                return (
                  <g transform="rotate(-90 100 100)">
                    <circle cx="100" cy="100" r={R[i]} fill="none" stroke={r.track} stroke-width="18" />
                    <circle class="ring" cx="100" cy="100" r={R[i]} fill="none" stroke={r.color} stroke-width="18" stroke-linecap="round" stroke-dasharray={g.dash} style={`--c:${g.c.toFixed(1)}`} />
                  </g>
                );
              })
            }
          </svg>
          <ul class="rings__legend">
            {
              rings.map((r) => (
                <li style={`--ring:${r.color}`}>
                  <span class="rings__name">{r.label}</span>
                  <strong class="rings__value">{r.value}{r.unit}</strong>
                  <span class="rings__note">{r.note}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <article class="card visit" data-visit>
        <h3 class="card__label">Your visit</h3>
        <p class="visit__big"><strong data-visit-total>–</strong><span>ms</span></p>
        <p class="card__meta" data-visit-where>to load this page in your browser</p>
        <ul class="visit__bars">
          <li><span>Find</span><i><b data-bar="dns"></b></i><em data-ms="dns">–</em></li>
          <li><span>Connect</span><i><b data-bar="connect"></b></i><em data-ms="connect">–</em></li>
          <li><span>Wait</span><i><b data-bar="wait"></b></i><em data-ms="wait">–</em></li>
          <li><span>Download</span><i><b data-bar="download"></b></i><em data-ms="download">–</em></li>
        </ul>
      </article>

      <article class="card vitals" data-vitals>
        <h3 class="card__label">How it feels (for you)</h3>
        <ul class="vitals__list">
          <li data-vital="lcp"><span><strong>Loads</strong> main content on screen</span><em>–</em></li>
          <li data-vital="cls"><span><strong>Stays put</strong> how much the page jumps</span><em>–</em></li>
          <li data-vital="inp"><span><strong>Responds</strong> after a tap or click</span><em>tap anything</em></li>
        </ul>
        <p class="card__meta">Core Web Vitals, measured live in your browser. Nothing is sent anywhere.</p>
      </article>
    </section>

    <section class="live" aria-label="Live status">
      <article class="card" data-live-ci>
        <h2 class="card__label">Latest CI run <span class="live__tag">Live</span></h2>
        <p class="ci-status" data-ci-state="unknown">
          <span class="ci-status__dot" aria-hidden="true"></span>
          <span data-ci-label>Checking…</span>
        </p>
        <p class="card__meta" data-ci-meta>Live status appears on the deployed site.</p>
      </article>
      <article class="card" data-live-stats>
        <h2 class="card__label">Visitors <span class="live__tag">Live</span></h2>
        <dl class="stats" data-stats hidden>
          <div><dt>Today</dt><dd data-stat="today">–</dd></div>
          <div><dt>This week</dt><dd data-stat="week">–</dd></div>
          <div><dt>Countries</dt><dd data-stat="countries">–</dd></div>
        </dl>
        <p class="card__meta" data-stats-fallback>Visitor numbers will show here once Cloudflare Web Analytics (cookie-free) is connected.</p>
      </article>
    </section>

    <section class="summary" aria-labelledby="tests-h">
      <h2 id="tests-h" class="section-h">Tests</h2>
      <div class="summary__grid">
        <article class="card card--big">
          <h3 class="card__label">Result</h3>
          <p class="big"><strong data-qa-passed>{t.passed}</strong> / {ran} passed <span class="big__rate">({passRate}%)</span></p>
          <p class="card__meta">
            {t.failed} failed · {t.flaky} flaky · {t.skipped} skipped on purpose
          </p>
        </article>
        <article class="card">
          <h3 class="card__label">Duration</h3>
          <p class="big"><strong>{minutes}m {String(seconds).padStart(2, '0')}s</strong></p>
          <p class="card__meta">{t.files.length} spec files</p>
        </article>
        <article class="card">
          <h3 class="card__label">Browser setups</h3>
          <ul class="chips">{t.projects.map((p) => <li class="pill">{p}</li>)}</ul>
        </article>
      </div>

      <div class="table-wrap" role="region" aria-label="Results per test file" tabindex="0">
        <table>
          <caption class="sr-only">Results per test file</caption>
          <thead>
            <tr><th scope="col">Spec file</th><th scope="col">Tests</th><th scope="col">Passed</th><th scope="col">Failed</th><th scope="col">Flaky</th><th scope="col">Skipped</th><th scope="col"><span class="sr-only">Pass bar</span></th></tr>
          </thead>
          <tbody>
            {
              t.files.map((f) => (
                <tr>
                  <th scope="row"><code>{f.file}</code></th>
                  <td>{f.total}</td>
                  <td class="ok">{f.passed}</td>
                  <td class:list={{ bad: f.failed > 0 }}>{f.failed}</td>
                  <td>{f.flaky ?? 0}</td>
                  <td>{f.skipped}</td>
                  <td>
                    <span class="bar" aria-hidden="true">
                      <span style={`width:${f.total - f.skipped ? Math.round(((f.passed + (f.flaky ?? 0)) / (f.total - f.skipped)) * 100) : 0}%`} />
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      qa.lighthouse.length > 0 && (
        <section aria-labelledby="lh-h">
          <h2 id="lh-h" class="section-h">Lighthouse (mobile)</h2>
          <p class="lh-avg">
            Average across {qa.lighthouse.length} pages:
            {categories.map((c, k) => (
              <>
                {k > 0 && ' · '}
                {c.label} <strong class={`num num--${grade(avg(c.key))}`}>{avg(c.key)}</strong>
              </>
            ))}
          </p>
          <div class="table-wrap" role="region" aria-label="Lighthouse scores per page" tabindex="0">
            <table>
              <caption class="sr-only">Lighthouse scores per page</caption>
              <thead>
                <tr>
                  <th scope="col">Page</th>
                  {categories.map((c) => (
                    <th scope="col">{c.label}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {qa.lighthouse.map((row) => (
                  <tr>
                    <th scope="row">
                      <a class="tap" href={row.path}>
                        <code>{row.path}</code>
                      </a>
                    </th>
                    {categories.map((c) => (
                      <td class={`num num--${grade(row[c.key])}`}>{row[c.key]}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section aria-labelledby="how-h">
      <h2 id="how-h" class="section-h">How this report is made</h2>
      <ol class="how">
        <li><strong>Push to main.</strong> GitHub Actions runs in Playwright's official Docker image.</li>
        <li><strong>Test.</strong> E2E, accessibility (axe, WCAG 2.2 AA) and visual tests on desktop Chrome, mobile Chrome and Safari's engine.</li>
        <li><strong>Measure.</strong> Lighthouse checks the key pages, and a script turns the results into this page.</li>
        <li><strong>Ship only if green.</strong> The site is rebuilt with this report and deployed to Cloudflare Pages.</li>
      </ol>
      {
        qa.runUrl && (
          <p>
            <a class="btn" href={qa.runUrl} target="_blank" rel="noopener">
              Open this run on GitHub ↗
            </a>
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  /* At a glance: Activity-style rings, your visit, your Core Web Vitals */
  .activity {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    margin-bottom: 40px;
  }
  .card.card--dark {
    background: #0c0c0e;
    color: #d6d6dc;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08) inset;
  }
  .card.card--dark .card__label {
    color: #9d9da6;
  }
  .rings {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .rings svg {
    flex: none;
    width: 180px;
    height: 180px;
  }
  .ring {
    animation: ring-fill 1.4s var(--ease-arrive) both;
  }
  @keyframes ring-fill {
    from {
      stroke-dasharray: 0 var(--c);
    }
  }
  .rings__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .rings__legend li {
    display: grid;
    padding-left: 12px;
    border-left: 3px solid var(--ring);
    line-height: 1.25;
  }
  .rings__name {
    font-size: 13px;
    color: #c7c7cf;
  }
  .rings__value {
    font-size: 26px;
    color: var(--ring);
    font-variant-numeric: tabular-nums;
  }
  .rings__note {
    font-size: 12px;
    color: #8e8e98;
  }
  .visit__big {
    margin: 4px 0 2px;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .visit__big strong {
    font-size: 48px;
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .visit__big span {
    color: var(--muted);
  }
  .visit__bars {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 13px;
  }
  .visit__bars li {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 52px;
    align-items: center;
    gap: 10px;
  }
  .visit__bars i {
    height: 6px;
    border-radius: 3px;
    background: var(--hover);
    overflow: hidden;
  }
  .visit__bars b {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 3px;
    background: var(--link);
    transition: width 0.6s var(--ease-arrive);
  }
  .visit__bars em,
  .vitals__list em {
    font-style: normal;
    text-align: right;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .vitals__list {
    list-style: none;
    margin: 6px 0 12px;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .vitals__list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-left: 12px;
    border-left: 3px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }
  .vitals__list li[data-grade='good'] {
    border-color: var(--pass);
  }
  .vitals__list li[data-grade='ok'] {
    border-color: var(--warn);
  }
  .vitals__list li[data-grade='poor'] {
    border-color: #ff453a;
  }
  .vitals__list strong {
    display: block;
    font-size: 14px;
    color: var(--text);
  }
  .vitals__list em {
    font-size: 18px;
    font-weight: 600;
  }
  @media (max-width: 999px) {
    .activity {
      grid-template-columns: 1fr 1fr;
    }
    .rings-card {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 599px) {
    .activity {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring {
      animation: none;
    }
  }
  .qa {
    padding-bottom: 48px;
  }
  .qa section + section {
    margin-top: 40px;
  }
  .section-h {
    font-size: 22px;
    margin-bottom: 16px;
  }
  .card {
    padding: 22px var(--tile-pad);
    border-radius: var(--radius);
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
  }
  .qa__source {
    margin-top: 14px !important;
    font-size: 14px !important;
    color: var(--muted);
  }
  .card__label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .card__meta {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .card__meta a {
    color: var(--link);
  }
  .live {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
  }
  .live__tag {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--pass-soft);
    color: var(--pass);
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  .ci-status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .ci-status__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--outline);
  }
  .ci-status[data-ci-state='passing'] .ci-status__dot {
    background: var(--pass);
    box-shadow: 0 0 0 5px var(--pass-soft);
  }
  .ci-status[data-ci-state='failing'] .ci-status__dot {
    background: var(--fail);
    box-shadow: 0 0 0 5px var(--fail-soft);
  }
  .ci-status[data-ci-state='running'] .ci-status__dot {
    background: var(--warn);
  }
  .stats {
    display: flex;
    gap: 32px;
    margin: 0;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dt {
    font-size: 13px;
    color: var(--muted);
  }
  .stats dd {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    color: var(--text);
  }
  .summary__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--gap);
    margin-bottom: var(--gap);
  }
  .big__rate {
    color: var(--pass);
    font-weight: 600;
  }
  .big {
    margin: 0;
    font-size: 18px;
    color: var(--body-text);
  }
  .big strong {
    font-size: 32px;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .table-wrap {
    /* Contains the absolutely positioned sr-only caption so it can't widen the page. */
    position: relative;
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    padding: 12px 18px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  thead th {
    font-size: 13px;
    color: var(--muted);
    font-weight: 600;
  }
  th,
  td {
    vertical-align: middle;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  tbody th {
    font-weight: 500;
    color: var(--text);
  }
  tbody th a {
    color: inherit;
  }
  td.ok {
    color: var(--pass);
    font-weight: 600;
  }
  td.bad {
    color: var(--fail);
    font-weight: 700;
  }
  .bar {
    display: block;
    width: 120px;
    height: 6px;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--pass);
  }
  .num {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .num--good {
    color: var(--pass);
  }
  .num--ok {
    color: var(--warn);
  }
  .num--poor {
    color: var(--fail);
  }
  .lh-avg {
    margin: 0 0 var(--gap);
    color: var(--muted);
    font-size: 15px;
  }
  .lh-avg strong {
    margin-right: 2px;
  }
  .how {
    margin: 0 0 16px;
    padding-left: 1.3em;
    max-width: 70ch;
  }
  .how li {
    margin: 8px 0;
  }
  .how strong {
    color: var(--text);
  }
  @media (max-width: 799px) {
    .live,
    .summary__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { getJSON, relativeTime, formatDuration, statusLabel, type CiSummary, type Stats } from '../../scripts/live';

  const ciCard = document.querySelector<HTMLElement>('[data-live-ci]')!;
  const state = ciCard.querySelector<HTMLElement>('[data-ci-state]')!;
  const label = ciCard.querySelector<HTMLElement>('[data-ci-label]')!;
  const meta = ciCard.querySelector<HTMLElement>('[data-ci-meta]')!;

  const loadCi = async () => {
    const run = await getJSON<CiSummary>('/api/ci');
    if (!run) {
      state.dataset.ciState = 'unknown';
      label.textContent = 'Unavailable';
      return;
    }
    state.dataset.ciState = run.status;
    label.textContent = statusLabel[run.status];
    meta.textContent = '';
    const link = document.createElement('a');
    link.href = run.url;
    link.target = '_blank';
    link.rel = 'noopener';
    link.textContent = `Run #${run.runNumber}`;
    const dur = formatDuration(run.durationSeconds);
    meta.append(link, ` · ${relativeTime(run.startedAt)}${dur ? ` · ${dur}` : ''} · ${run.commit}`);
  };

  const statsCard = document.querySelector<HTMLElement>('[data-live-stats]')!;
  const loadStats = async () => {
    const s = await getJSON<Stats>('/api/stats');
    if (!s) return;
    (['today', 'week', 'countries'] as const).forEach((k) => {
      statsCard.querySelector(`[data-stat="${k}"]`)!.textContent = s[k].toLocaleString('en');
    });
    statsCard.querySelector<HTMLElement>('[data-stats]')!.hidden = false;
    statsCard.querySelector<HTMLElement>('[data-stats-fallback]')!.hidden = true;
  };


  // Your visit: how long this page took to reach you, from the browser's own timing.
  const visit = document.querySelector<HTMLElement>('[data-visit]');
  const showVisit = () => {
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    if (!visit || !nav || !nav.responseEnd) return;
    const parts = {
      dns: nav.domainLookupEnd - nav.domainLookupStart,
      connect: nav.connectEnd - nav.connectStart,
      wait: nav.responseStart - nav.requestStart,
      download: nav.responseEnd - nav.responseStart,
    };
    const total = Math.round(nav.responseEnd - nav.startTime);
    visit.querySelector('[data-visit-total]')!.textContent = String(total);
    const max = Math.max(...Object.values(parts), 1);
    (Object.keys(parts) as (keyof typeof parts)[]).forEach((k) => {
      const ms = Math.max(0, Math.round(parts[k]));
      visit.querySelector(`[data-ms="${k}"]`)!.textContent = `${ms} ms`;
      visit.querySelector<HTMLElement>(`[data-bar="${k}"]`)!.style.width = `${Math.max(2, (ms / max) * 100)}%`;
    });
  };
  if (document.readyState === 'complete') showVisit();
  else window.addEventListener('load', showVisit, { once: true });

  // Which Cloudflare data centre served you (only on the live site).
  const CITIES: Record<string, string> = {
    DAC: 'Dhaka', CGP: 'Chattogram', CCU: 'Kolkata', DEL: 'Delhi', BOM: 'Mumbai', MAA: 'Chennai', SIN: 'Singapore',
    KUL: 'Kuala Lumpur', BKK: 'Bangkok', HKG: 'Hong Kong', NRT: 'Tokyo', ICN: 'Seoul', SYD: 'Sydney', DXB: 'Dubai',
    FRA: 'Frankfurt', AMS: 'Amsterdam', LHR: 'London', CDG: 'Paris', ARN: 'Stockholm', WAW: 'Warsaw', BUD: 'Budapest',
    VIE: 'Vienna', MAD: 'Madrid', MXP: 'Milan', IAD: 'Ashburn', EWR: 'Newark', ORD: 'Chicago', DFW: 'Dallas',
    LAX: 'Los Angeles', SJC: 'San Jose', SEA: 'Seattle', YYZ: 'Toronto', GRU: 'São Paulo',
  };
  fetch('/cdn-cgi/trace')
    .then((r) => (r.ok ? r.text() : ''))
    .then((text) => {
      const colo = /^colo=(\w+)$/m.exec(text)?.[1];
      if (!colo || !visit) return;
      visit.querySelector('[data-visit-where]')!.textContent = `to load this page, served by Cloudflare in ${CITIES[colo] ?? colo}`;
    })
    .catch(() => undefined);

  // Your Core Web Vitals, measured in this browser and shown only to you.
  const vitals = document.querySelector<HTMLElement>('[data-vitals]');
  const setVital = (name: string, text: string, grade: 'good' | 'ok' | 'poor') => {
    const li = vitals?.querySelector<HTMLElement>(`[data-vital="${name}"]`);
    if (!li) return;
    li.querySelector('em')!.textContent = text;
    li.dataset.grade = grade;
  };
  const observe = (type: string, cb: (entries: PerformanceEntryList) => void, extra: Record<string, unknown> = {}) => {
    try {
      new PerformanceObserver((list) => cb(list.getEntries())).observe({ type, buffered: true, ...extra } as PerformanceObserverInit);
    } catch {
      /* not supported in this browser */
    }
  };
  observe('largest-contentful-paint', (entries) => {
    const ms = entries.at(-1)!.startTime;
    setVital('lcp', `${(ms / 1000).toFixed(1)} s`, ms <= 2500 ? 'good' : ms <= 4000 ? 'ok' : 'poor');
  });
  let cls = 0;
  setVital('cls', '0.00', 'good');
  observe('layout-shift', (entries) => {
    for (const e of entries as (PerformanceEntry & { value: number; hadRecentInput: boolean })[]) if (!e.hadRecentInput) cls += e.value;
    setVital('cls', cls.toFixed(2), cls <= 0.1 ? 'good' : cls <= 0.25 ? 'ok' : 'poor');
  });
  let inp = 0;
  observe(
    'event',
    (entries) => {
      for (const e of entries) inp = Math.max(inp, e.duration);
      if (inp) setVital('inp', `${Math.round(inp)} ms`, inp <= 200 ? 'good' : inp <= 500 ? 'ok' : 'poor');
    },
    { durationThreshold: 16 },
  );

  void loadCi();
  void loadStats();
  // Keep the live cards fresh while the page is open.
  setInterval(() => {
    if (document.visibilityState === 'visible') {
      void loadCi();
      void loadStats();
    }
  }, 60_000);
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../content/site.json';

const notes = [
  { id: 'about', title: 'About', preview: site.tagline },
  { id: 'experience', title: 'Experience', preview: `${site.experience[0]!.role} at ${site.experience[0]!.company}` },
  { id: 'achievements', title: 'Key achievements', preview: site.achievements[0]!.title },
  { id: 'skills', title: 'Skills', preview: site.skills.slice(0, 4).map((s) => s.name).join(', ') },
  { id: 'education', title: 'Education & languages', preview: site.education[0]!.degree },
  { id: 'community', title: 'WordPress community', preview: `${site.wordpress.badge} · ${site.wordpress.locale}` },
  { id: 'now', title: 'Now', preview: site.status.detail },
];

const groups = Object.entries(
  site.skills.reduce<Record<string, string[]>>((acc, s) => {
    (acc[s.group] ??= []).push(s.name);
    return acc;
  }, {}),
);
const folder = `About ${site.firstName}`;
---

<BaseLayout title="About | Rakibul Islam" description={`About ${site.name}: ${site.summary}`}>
  <div class="container about-wrap">
    <section class="nw" data-notes aria-label={`About ${site.firstName}, presented as an Apple Notes window`}>
      <header class="nw__bar">
        <span class="nw__lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <button class="nw__icon nw__toggle" type="button" data-notes-toggle aria-label="Hide Notes sidebars" aria-expanded="true">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"></rect><path d="M9 5v14" stroke="currentColor" stroke-width="1.6"></path></svg>
        </button>
        <span class="nw__app">Notes</span>
        <span class="nw__tools">
          <a class="nw__icon" href={`mailto:${site.email}?subject=Hello%20via%20your%20portfolio`} aria-label={`Email ${site.firstName}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6"></rect><path d="m4 8 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
          </a>
          <button class="nw__icon" type="button" data-notes-new aria-label="Create a temporary note">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 4H6.5A2.5 2.5 0 0 0 4 6.5v11A2.5 2.5 0 0 0 6.5 20h11a2.5 2.5 0 0 0 2.5-2.5V12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path><path d="m10 14 .6-2.9L18.4 3.3a1.4 1.4 0 0 1 2 0l.3.3a1.4 1.4 0 0 1 0 2l-7.8 7.8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
          </button>
        </span>
      </header>

      <div class="nw__body">
        <aside class="nw__folders" aria-label="Notes folders">
          <p class="nw__group">iCloud</p>
          <p class="nw__folder is-on"><span>{folder}</span><span class="nw__n">{notes.length}</span></p>
          <p class="nw__group">On My Mac</p>
          <p class="nw__folder"><span>Quick Notes</span><span class="nw__n" data-notes-quick>0</span></p>
          <div class="nw__me">
            <img data-me src="/portrait/photo-192.webp" data-photo="/portrait/photo-192.webp" data-avatar="/portrait/avatar-192.webp" width="32" height="32" alt="" decoding="async" />
            <span><strong>{site.name}</strong><small>{notes.length} notes</small></span>
          </div>
        </aside>

        <nav class="nw__list" aria-label="About page sections">
          <p class="nw__listhead"><strong>{folder}</strong><span>{notes.length} notes</span></p>
          <button class="nw__row nw__row--draft" type="button" data-notes-draft hidden>
            <span class="nw__title" data-draft-title>New Note</span>
            <span class="nw__preview" data-draft-preview>Start typing…</span>
          </button>
          {
            notes.map((n, i) => (
              <a class:list={['nw__row', { 'is-on': i === 0 }]} href={`#${n.id}`} data-note-link={n.id} aria-current={i === 0 ? 'true' : undefined}>
                <span class="nw__title">{n.title}</span>
                <span class="nw__preview">{n.preview}</span>
              </a>
            ))
          }
        </nav>

        <div class="nw__main">
          <article class="nw__editor prose" data-notes-editor tabindex="-1">
            <p class="nw__date">About {site.name}</p>

            <section id="about" class="note note--intro" data-note="about" aria-labelledby="h-about">
              <img class="note__me" data-me src="/portrait/photo-192.webp" data-photo="/portrait/photo-192.webp" data-avatar="/portrait/avatar-192.webp" width="96" height="96" alt={`Portrait of ${site.name}`} decoding="async" />
              <p class="note__eyebrow">{site.role}</p>
              <h1 id="h-about">Hey, I'm {site.firstName}.</h1>
              <p><strong>{site.tagline}</strong></p>
              <p>{site.summary}</p>
              {site.story.map((p) => <p>{p}</p>)}
              <p>{site.intro[1]}</p>
            </section>

            <section id="experience" class="note" data-note="experience" aria-labelledby="h-experience">
              <h2 id="h-experience">Experience</h2>
              {
                site.experience.map((e) => (
                  <article class="job">
                    <h3>
                      {e.role} <span class="job__at">· {e.company}</span>
                    </h3>
                    <p class="job__meta">
                      {e.period} · {e.place}
                    </p>
                    <ul>
                      {e.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </article>
                ))
              }
            </section>

            <section id="achievements" class="note" data-note="achievements" aria-labelledby="h-achievements">
              <h2 id="h-achievements">Key achievements</h2>
              {
                site.achievements.map((a) => (
                  <>
                    <h3>{a.title}</h3>
                    <p>{a.detail}</p>
                  </>
                ))
              }
              <p><a href="/projects/flexorder-e2e/">Read the FlexOrder case study →</a></p>
            </section>

            <section id="skills" class="note" data-note="skills" aria-labelledby="h-skills">
              <h2 id="h-skills">Skills</h2>
              <dl class="skills-dl">
                {
                  groups.map(([group, names]) => (
                    <div>
                      <dt>{group}</dt>
                      <dd>{names.join(' · ')}</dd>
                    </div>
                  ))
                }
              </dl>
            </section>

            <section id="education" class="note" data-note="education" aria-labelledby="h-education">
              <h2 id="h-education">Education &amp; languages</h2>
              {
                site.education.map((ed) => (
                  <>
                    <h3>{ed.degree}</h3>
                    <p class="job__meta">
                      {ed.school} · {ed.period} · {ed.place}
                    </p>
                  </>
                ))
              }
              <p><a href="/certificates/">See my {site.certifications.length} course certificates →</a></p>
              <h3>Languages</h3>
              <ul>
                {
                  site.languages.map((l) => (
                    <li>
                      <strong>{l.name}</strong>: {l.level}
                    </li>
                  ))
                }
              </ul>
            </section>

            <section id="community" class="note" data-note="community" aria-labelledby="h-community">
              <h2 id="h-community">WordPress community</h2>
              <p>
                I've been on WordPress.org since {site.wordpress.joined}, as <a href={site.links.wordpress} target="_blank" rel="me noopener">{site.wordpress.handle}</a>.
                I'm part of the <strong>{site.wordpress.team} team</strong>, with an interest in plugin, theme and core testing.
              </p>
              <p>
                I also translate WordPress into Bengali. That earned me the <strong>{site.wordpress.badge}</strong> badge in {site.wordpress.badgeYear}:{' '}
                {site.wordpress.approved} strings approved and {site.wordpress.suggested} more suggested, across {site.wordpress.projects.length} projects.
              </p>
              <ul>
                {site.wordpress.projects.map((p) => <li>{p}</li>)}
              </ul>
              <p>{site.wordpress.props}, and I review plugins I use on the WordPress.org forums.</p>
              <p><a href={site.wordpress.translate} target="_blank" rel="noopener">See Bengali translations on translate.wordpress.org ↗</a></p>
            </section>

            <section id="now" class="note" data-note="now" aria-labelledby="h-now">
              <h2 id="h-now">Now</h2>
              <p><strong>{site.status.headline}.</strong> {site.status.detail}</p>
              <p>
                At WPPOOL I'm extending Playwright coverage and CI pipelines across our WordPress and WooCommerce plugins, and
                writing up what I learn along the way.
              </p>
              <p><a href="/cv/">View my CV →</a></p>
            </section>

            <footer class="nw__sign">
              <p>Got a release that needs a safety net?</p>
              <a href={`mailto:${site.email}?subject=Hello%20via%20your%20portfolio`}>{site.email}</a>
            </footer>
          </article>

          <section class="nw__temp" data-notes-temp aria-label="Temporary note editor" hidden>
            <button class="nw__back" type="button" data-notes-back>‹ {folder}</button>
            <p class="nw__date">Temporary note · Not saved</p>
            <label class="sr-only" for="temp-title">Note title</label>
            <input id="temp-title" class="nw__temp-title" type="text" placeholder="New Note" autocomplete="off" data-temp-title />
            <label class="sr-only" for="temp-body">Note body</label>
            <textarea id="temp-body" class="nw__temp-body" rows="10" placeholder="Start typing…" data-temp-body></textarea>
            <p class="nw__hint">This note only lives in this browser tab and disappears when the page is refreshed.</p>
          </section>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { applyLook, savedLook } from '../../scripts/look';
  import { initNotes } from '../../scripts/notes';
  applyLook(savedLook());
  initNotes();
</script>

<style>
  .about-wrap {
    width: min(100% - 32px, 1280px);
  }
  /* The window fills the screen on wider screens and the note scrolls inside it, like Apple Notes. */
  .nw {
    --nw-h: calc(100dvh - 96px - 32px);
    display: flex;
    flex-direction: column;
    height: max(560px, var(--nw-h));
    border-radius: 18px;
    background: var(--tile);
    box-shadow: 0 0 0 1px var(--tile-edge) inset, var(--shadow);
    overflow: hidden;
  }
  .nw__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
    flex: none;
  }
  .nw__lights {
    display: flex;
    gap: 8px;
    margin-right: 8px;
  }
  .nw__lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.2) inset;
  }
  .nw__lights i:nth-child(2) {
    background: #febc2e;
  }
  .nw__lights i:nth-child(3) {
    background: #28c840;
  }
  .nw__app {
    flex: 1;
    text-align: center;
    font-weight: 600;
    color: var(--text);
  }
  .nw__tools {
    display: flex;
    gap: 4px;
  }
  .nw__icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .nw__icon:hover {
    background: var(--hover);
    color: var(--text);
  }

  .nw__body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 210px 290px minmax(0, 1fr);
  }
  .nw.is-sidebar-hidden .nw__body {
    grid-template-columns: minmax(0, 1fr);
  }
  .nw.is-sidebar-hidden .nw__folders,
  .nw.is-sidebar-hidden .nw__list {
    display: none;
  }

  .nw__folders {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 10px;
    background: var(--card);
    border-right: 1px solid var(--line);
    font-size: 13px;
  }
  .nw__group {
    margin: 10px 10px 4px;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
  }
  .nw__group:first-child {
    margin-top: 0;
  }
  .nw__folder {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 7px 10px;
    border-radius: 8px;
    color: var(--text);
  }
  .nw__folder.is-on {
    background: var(--hover);
    font-weight: 600;
  }
  .nw__n {
    color: var(--muted);
  }
  .nw__me {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
  }
  .nw__me img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }
  .nw__me span {
    display: grid;
    line-height: 1.3;
  }
  .nw__me small {
    color: var(--muted);
  }

  .nw__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 10px;
    border-right: 1px solid var(--line);
    overflow-y: auto;
  }
  .nw__listhead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0 10px 8px;
    font-size: 14px;
  }
  .nw__listhead span {
    font-size: 12px;
    color: var(--muted);
  }
  .nw__row {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border: 0;
    border-radius: 10px;
    background: none;
    text-align: left;
    text-decoration: none;
    font: inherit;
    cursor: pointer;
  }
  .nw__row[hidden] {
    display: none;
  }
  .nw__row:hover {
    background: var(--hover);
  }
  .nw__row.is-on {
    /* Notes-app yellow, same in both themes; text stays dark for contrast. */
    background: #ffc23d;
  }
  .nw__row.is-on .nw__title,
  .nw__row.is-on .nw__preview {
    color: #1a1204;
  }
  .nw__title {
    font-weight: 600;
    font-size: 14px;
    color: var(--text);
  }
  .nw__preview {
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nw__main {
    min-width: 0;
    min-height: 0;
    display: grid;
  }
  .nw__editor,
  .nw__temp {
    grid-area: 1 / 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-behavior: smooth;
    padding: 20px clamp(24px, 5vw, 64px) 56px;
  }
  .nw__editor[hidden] {
    display: none;
  }
  .nw__editor:focus {
    outline: none;
  }
  .nw__editor > * {
    max-width: 680px;
    margin-inline: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .nw__editor {
      scroll-behavior: auto;
    }
  }
  .nw__date {
    text-align: center;
    font-size: 12px;
    color: var(--muted);
    margin: 0 auto 20px;
  }
  .note {
    scroll-margin-top: 16px;
  }
  .note + .note {
    margin-top: 44px;
  }
  .note__me {
    width: 88px;
    height: 88px;
    border-radius: 20px;
    object-fit: cover;
    margin-bottom: 14px;
  }
  .note__eyebrow {
    margin: 0 0 4px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .note h1 {
    font-size: clamp(34px, 4vw, 48px);
    margin: 0 0 16px;
  }
  .note h2 {
    font-size: 28px;
    margin-top: 0;
  }
  .job + .job {
    margin-top: 28px;
  }
  .job h3 {
    margin: 0 0 4px;
  }
  .job__at {
    color: var(--muted);
    font-weight: 500;
  }
  .job__meta {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 10px;
  }
  .skills-dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .skills-dl dt {
    font-weight: 600;
    color: var(--text);
  }
  .skills-dl dd {
    margin: 0;
  }
  .nw__sign {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .nw__sign p {
    margin: 0 0 4px;
  }

  .nw__temp[hidden] {
    display: none;
  }
  .nw__temp {
    display: flex;
    flex-direction: column;
    background: var(--tile);
  }
  .nw__back {
    align-self: flex-start;
    border: 0;
    background: none;
    padding: 4px 0;
    color: #b07800;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  :global(html[data-theme='dark']) .nw__back {
    color: #ffc23d;
  }
  .nw__temp-title,
  .nw__temp-body {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    resize: none;
  }
  .nw__temp-title {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .nw__temp-body {
    flex: 1;
    min-height: 240px;
    font-size: 17px;
    line-height: 1.6;
  }
  .nw__temp-title:focus-visible,
  .nw__temp-body:focus-visible {
    outline: 2px solid var(--focus, #ffc23d);
    outline-offset: 4px;
    border-radius: 6px;
  }
  .nw__hint {
    max-width: 680px;
    width: 100%;
    margin: 16px auto 0;
    font-size: 13px;
    color: var(--muted);
  }

  /* Medium screens: no folders column. */
  @media (max-width: 1100px) {
    .nw__body {
      grid-template-columns: 260px minmax(0, 1fr);
    }
    .nw__folders {
      display: none;
    }
  }
  /* Phones and small tablets: one long note that scrolls with the page. */
  @media (max-width: 760px) {
    .nw {
      height: auto;
      overflow: visible;
    }
    .nw__body,
    .nw.is-sidebar-hidden .nw__body {
      grid-template-columns: minmax(0, 1fr);
    }
    .nw__list,
    .nw__toggle {
      display: none;
    }
    .nw__editor,
    .nw__temp {
      overflow: visible;
      padding: 20px 20px 36px;
    }
    .note {
      scroll-margin-top: 24px;
    }
  }
</style>

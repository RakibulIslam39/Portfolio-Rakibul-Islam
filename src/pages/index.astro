---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/tiles/Hero.astro';
import TerminalTile from '../components/tiles/TerminalTile.astro';
import Portrait from '../components/tiles/Portrait.astro';
import Status from '../components/tiles/Status.astro';
import Report from '../components/tiles/Report.astro';
import CiRun from '../components/tiles/CiRun.astro';
import MapTile from '../components/tiles/MapTile.astro';
import Contact from '../components/tiles/Contact.astro';
import Projects from '../components/tiles/Projects.astro';
import Career from '../components/tiles/Career.astro';
import Switcher from '../components/tiles/Switcher.astro';
import Stats from '../components/tiles/Stats.astro';
import Book from '../components/tiles/Book.astro';
import IMessage from '../components/IMessage.astro';
import Skills from '../components/tiles/Skills.astro';
import Plugins from '../components/tiles/Plugins.astro';
import BugHunt from '../components/tiles/BugHunt.astro';
import Certificates from '../components/tiles/Certificates.astro';
import Blog from '../components/tiles/Blog.astro';
---

<BaseLayout
  preloadImage={{
    srcset: '/portrait/photo-400.webp 400w, /portrait/photo-640.webp 640w, /portrait/photo.webp 800w',
    sizes: '(min-width: 1024px) 340px, (min-width: 700px) 50vw, 100vw',
  }}
>
  <!-- DOM order is the phone order; named areas place tiles on wider screens. -->
  <div class="bento container" data-bento>
    <Hero />
    <Portrait />
    <MapTile />
    <Switcher />
    <TerminalTile />
    <Status />
    <Report />
    <CiRun />
    <Projects />
    <Career />
    <Skills />
    <Blog />
    <Certificates />
    <BugHunt />
    <Book />
    <Stats />
    <Plugins />
    <Contact />
  </div>
  <!-- Put a visitor's saved tile order back before the first paint (see src/scripts/rearrange.ts). -->
  <script is:inline>
    (function () {
      var layout = {};
      try { layout = JSON.parse(localStorage.getItem('home-layout') || '{}') || {}; } catch (e) {}
      if (!Object.keys(layout).length) return;
      var grid = document.querySelector('[data-bento]');
      var tiles = Array.prototype.slice.call(grid.children).filter(function (t) { return t.classList.contains('tile'); });
      var home = {};
      tiles.forEach(function (t, i) { home[t.id] = { area: t.getAttribute('data-area') || '', order: i }; });
      tiles.forEach(function (t) {
        var slot = home[layout[t.id]] || home[t.id];
        t.style.setProperty('--area', slot.area);
        t.style.order = String(slot.order);
        t.setAttribute('data-slot', layout[t.id] && home[layout[t.id]] ? layout[t.id] : t.id);
      });
    })();
  </script>
  <div class="layout-bar container" data-layout-bar>
    <button class="btn layout-bar__edit" type="button" data-layout-edit>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg>
      Edit layout
    </button>
    <button class="btn" type="button" data-layout-reset hidden>Reset layout</button>
    <button class="btn btn--primary" type="button" data-layout-done hidden>Done</button>
    <p class="sr-only" aria-live="polite" data-layout-status></p>
  </div>
  <IMessage />
</BaseLayout>

<script>
  import { initRearrange } from '../scripts/rearrange';
  const grid = document.querySelector<HTMLElement>('[data-bento]');
  if (grid) initRearrange(grid);
  if (location.hash === '#edit-layout') document.querySelector<HTMLButtonElement>('[data-layout-edit]')?.click();
</script>

<style>
  .layout-bar {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: -24px auto 48px;
  }
  .layout-bar .btn {
    min-height: var(--tap);
  }
  /* Edit mode: tiles jiggle like iPhone widgets and become drag handles. */
  :global(.bento--editing > .tile) {
    cursor: grab;
    touch-action: none;
    user-select: none;
    animation: jiggle 0.32s ease-in-out infinite alternate;
    box-shadow: 0 0 0 1px var(--outline) inset;
  }
  :global(.bento--editing > .tile:nth-child(even)) {
    animation-delay: -0.16s;
  }
  :global(.bento--editing > .tile:focus-visible) {
    outline: 3px solid var(--link);
    outline-offset: 3px;
  }
  :global(.bento > .tile.is-dragging) {
    z-index: 5;
    cursor: grabbing;
    animation: none !important;
    scale: 1.03;
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.5);
  }
  :global(.bento > .tile.is-target) {
    box-shadow: 0 0 0 3px var(--link) inset !important;
  }
  @keyframes jiggle {
    from {
      rotate: -0.5deg;
    }
    to {
      rotate: 0.5deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.bento--editing > .tile) {
      animation: none;
    }
  }
  /* Tiles below the fold skip style, layout and paint until they come near the screen. */
  .bento > :global(.tile:nth-child(n + 5)) {
    content-visibility: auto;
    contain-intrinsic-size: auto 320px;
  }
  .bento {
    width: min(100% - 32px, var(--max-wide));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: auto;
    gap: var(--gap);
    margin-bottom: 48px;
  }
  @media (min-width: 700px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(220px, auto);
      grid-template-areas:
        'hero hero'
        'photo map'
        'switch switch'
        'term term'
        'status status'
        'report report'
        'ci ci'
        'proj proj'
        'tl tl'
        'skills skills'
        'blog blog'
        'certs certs'
        'bug bug'
        'book stats'
        'plugins contact';
    }
    .bento > :global(.tile) {
      grid-area: var(--area);
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(240px, auto);
      grid-template-areas:
        'hero hero photo map'
        'hero hero switch switch'
        'term term status status'
        'report report ci ci'
        'proj proj tl tl'
        'proj proj skills skills'
        'blog blog certs certs'
        'bug bug plugins contact'
        'book stats plugins contact';
    }
  }
</style>

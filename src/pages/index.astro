---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/tiles/Hero.astro';
import Portrait from '../components/tiles/Portrait.astro';
import Status from '../components/tiles/Status.astro';
import Report from '../components/tiles/Report.astro';
import CiRun from '../components/tiles/CiRun.astro';
import MapTile from '../components/tiles/MapTile.astro';
import Contact from '../components/tiles/Contact.astro';
import Projects from '../components/tiles/Projects.astro';
import Career from '../components/tiles/Career.astro';
import Switcher from '../components/tiles/Switcher.astro';
import Stats from '../components/tiles/Stats.astro';
import Book from '../components/tiles/Book.astro';
import IMessage from '../components/IMessage.astro';
import Skills from '../components/tiles/Skills.astro';
import Plugins from '../components/tiles/Plugins.astro';
import BugHunt from '../components/tiles/BugHunt.astro';
import Certificates from '../components/tiles/Certificates.astro';
import Blog from '../components/tiles/Blog.astro';
---

<BaseLayout
  title="Rakibul Islam | QA Automation Engineer & SDET (Playwright)"
  description="Rakibul Islam is a QA Automation Engineer and SDET in Dhaka, Bangladesh. Playwright and TypeScript test automation, API testing and CI/CD for WordPress and WooCommerce."
  ogType="profile"
  preloadImage={{
    srcset: '/portrait/photo-400.webp 400w, /portrait/photo-640.webp 640w, /portrait/photo.webp 800w',
    sizes: '(min-width: 1024px) 340px, (min-width: 700px) 50vw, 100vw',
  }}
>
  <!-- DOM order is the phone order; named areas place tiles on wider screens. -->
  <div class="bento container" data-bento>
    <Hero />
    <Portrait />
    <MapTile />
    <Switcher />
    <Projects />
    <Report />
    <Status />
    <CiRun />
    <Skills />
    <Career />
    <Blog />
    <Certificates />
    <BugHunt />
    <Book />
    <Stats />
    <Plugins />
    <Contact />
  </div>
  <!-- Tiles rise into place on the first visit of a session only, not every time you come back. -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      try {
        if (sessionStorage.getItem('arrived')) root.setAttribute('data-arrived', '');
        else sessionStorage.setItem('arrived', '1');
      } catch (e) {
        root.setAttribute('data-arrived', '');
      }
    })();
  </script>
  <!-- Put a visitor's saved tile order back before the first paint (see src/scripts/rearrange.ts). -->
  <script is:inline>
    (function () {
      var layout = {};
      try { layout = JSON.parse(localStorage.getItem('home-layout-v3') || '{}') || {}; } catch (e) {}
      if (!Object.keys(layout).length) return;
      var grid = document.querySelector('[data-bento]');
      var tiles = Array.prototype.slice.call(grid.children).filter(function (t) { return t.classList.contains('tile'); });
      var home = {};
      tiles.forEach(function (t, i) { home[t.id] = { area: t.getAttribute('data-area') || '', order: i }; });
      tiles.forEach(function (t) {
        var slot = home[layout[t.id]] || home[t.id];
        t.style.setProperty('--area', slot.area);
        t.style.order = String(slot.order);
        t.setAttribute('data-slot', layout[t.id] && home[layout[t.id]] ? layout[t.id] : t.id);
      });
    })();
  </script>
  <div class="layout-bar container" data-layout-bar>
    <button class="btn layout-bar__edit" type="button" data-layout-edit>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg>
      Edit layout
    </button>
    <button class="btn" type="button" data-layout-reset hidden>Reset layout</button>
    <button class="btn btn--primary" type="button" data-layout-done hidden>Done</button>
    <p class="sr-only" aria-live="polite" data-layout-status></p>
  </div>
  <IMessage />
</BaseLayout>

<script>
  import { initRearrange } from '../scripts/rearrange';
  import { initGlow } from '../scripts/glow';
  const grid = document.querySelector<HTMLElement>('[data-bento]');
  if (grid) {
    initRearrange(grid);
    initGlow(grid);
  }
  if (location.hash === '#edit-layout') document.querySelector<HTMLButtonElement>('[data-layout-edit]')?.click();
</script>

<style>
  .layout-bar {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: -24px auto 48px;
  }
  .layout-bar .btn {
    min-height: var(--tap);
  }
  /* Edit mode: tiles jiggle like iPhone widgets and become drag handles. */
  :global(.bento--editing > .tile) {
    cursor: grab;
    touch-action: none;
    user-select: none;
    animation: jiggle 0.32s ease-in-out infinite alternate;
    box-shadow: 0 0 0 1px var(--outline) inset;
  }
  :global(.bento--editing > .tile:nth-child(even)) {
    animation-delay: -0.16s;
  }
  :global(.bento--editing > .tile:focus-visible) {
    outline: 3px solid var(--link);
    outline-offset: 3px;
  }
  :global(.bento > .tile.is-dragging) {
    z-index: 5;
    cursor: grabbing;
    animation: none !important;
    scale: 1.03;
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.5);
  }
  :global(.bento > .tile.is-target) {
    box-shadow: 0 0 0 3px var(--link) inset !important;
  }
  @keyframes jiggle {
    from {
      rotate: -0.5deg;
    }
    to {
      rotate: 0.5deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.bento--editing > .tile) {
      animation: none;
    }
  }
  .bento {
    width: min(100% - 32px, var(--max-wide));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: auto;
    gap: var(--gap);
    margin-bottom: 48px;
  }
  @media (min-width: 700px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(220px, auto);
      grid-template-areas:
        'hero hero'
        'photo map'
        'switch switch'
        'proj proj'
        'report report'
        'status status'
        'ci ci'
        'skills skills'
        'tl tl'
        'blog blog'
        'certs certs'
        'bug bug'
        'book stats'
        'plugins contact';
    }
    .bento > :global(.tile) {
      grid-area: var(--area);
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(240px, auto);
      grid-template-areas:
        'hero hero photo map'
        'hero hero switch switch'
        'proj proj report report'
        'proj proj status status'
        'ci ci skills skills'
        'tl tl tl tl'
        'blog blog certs certs'
        'bug bug plugins contact'
        'book stats plugins contact';
    }
  }

  /* Arrival: after the hero and portrait (left alone, so the page's main content paints at once),
     each tile fades and rises 8 px, 40 ms after the one before. First visit of a session only. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-arrived])) .bento > :global(.tile:nth-child(n + 3)) {
      animation: tile-in 0.5s var(--ease-arrive) both;
      animation-delay: calc(var(--i, 0) * 40ms);
    }
  }
  .bento > :global(.tile:nth-child(3)) {
    --i: 1;
  }
  .bento > :global(.tile:nth-child(4)) {
    --i: 2;
  }
  .bento > :global(.tile:nth-child(5)) {
    --i: 3;
  }
  .bento > :global(.tile:nth-child(6)) {
    --i: 4;
  }
  .bento > :global(.tile:nth-child(7)) {
    --i: 5;
  }
  .bento > :global(.tile:nth-child(8)) {
    --i: 6;
  }
  .bento > :global(.tile:nth-child(9)) {
    --i: 7;
  }
  .bento > :global(.tile:nth-child(10)) {
    --i: 8;
  }
  .bento > :global(.tile:nth-child(11)) {
    --i: 9;
  }
  .bento > :global(.tile:nth-child(12)) {
    --i: 10;
  }
  .bento > :global(.tile:nth-child(13)) {
    --i: 11;
  }
  .bento > :global(.tile:nth-child(14)) {
    --i: 12;
  }
  .bento > :global(.tile:nth-child(15)) {
    --i: 13;
  }
  .bento > :global(.tile:nth-child(16)) {
    --i: 14;
  }
  .bento > :global(.tile:nth-child(17)) {
    --i: 15;
  }
  .bento > :global(.tile:nth-child(18)) {
    --i: 16;
  }
  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Pointer glow (src/scripts/glow.ts): a soft teal light on the tile edges near the mouse. */
  .bento[data-glow] > :global(.tile)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    background: radial-gradient(240px circle at var(--gx, -999px) var(--gy, -999px), color-mix(in srgb, var(--accent) 75%, transparent), transparent 70%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .bento[data-glow]:hover > :global(.tile)::after {
    opacity: 1;
  }
  .bento--editing[data-glow] > :global(.tile)::after {
    display: none;
  }
</style>

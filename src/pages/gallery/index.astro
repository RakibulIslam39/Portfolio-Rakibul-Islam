---
import BaseLayout from '../../layouts/BaseLayout.astro';
import gallery from '../../content/gallery.json';

type Photo = (typeof gallery.photos)[number];
const byId = new Map(gallery.photos.map((p) => [p.id, p]));
const placeOf = new Map<string, string>();
for (const h of gallery.highlights) for (const id of h.photos) placeOf.set(id, h.place);
const src = (id: string, small = false) => `/gallery/${id}${small ? '-sm' : ''}.webp`;
const slides = (ids: string[]) =>
  JSON.stringify(
    ids.map((id) => {
      const p = byId.get(id)!;
      return { src: src(id), w: p.w, h: p.h, caption: p.caption, alt: p.alt, place: placeOf.get(id) ?? '' };
    }),
  );
const all: Photo[] = gallery.photos;
const origin = Astro.site!.toString();
const gallerySchema = {
  '@type': 'ImageGallery',
  name: 'Travel gallery',
  url: new URL('/gallery/', origin).href,
  author: { '@id': new URL('/#person', origin).href },
  image: all.map((p) => ({
    '@type': 'ImageObject',
    contentUrl: new URL(src(p.id), origin).href,
    caption: p.caption,
    description: p.alt,
    contentLocation: placeOf.get(p.id),
    creator: { '@id': new URL('/#person', origin).href },
  })),
};
---

<BaseLayout
  title="Travel Gallery | Rakibul Islam"
  description="Travel photos by Rakibul Islam from around Bangladesh: Cox's Bazar sea beach, a WPPOOL team trip, Hardinge Bridge and Rooppur in Pabna."
  schema={[gallerySchema]}
>
  <div class="container">
    <header class="page-head">
      <h1>Gallery</h1>
      <p>Places I've been and photos from the trips. Tap a highlight to play it like a story.</p>
    </header>

    <section class="hl" aria-labelledby="hl-h">
      <h2 id="hl-h" class="sr-only">Highlights</h2>
      <ul class="hl__list">
        {
          gallery.highlights.map((h) => (
            <li>
              <button class="hl__btn" type="button" data-story={slides(h.photos)} data-story-title={h.title}>
                <span class="hl__ring">
                  <img src={src(h.cover, true)} alt="" width="88" height="88" style={`object-position:${h.coverPosition}`} decoding="async" />
                </span>
                <span class="hl__title">{h.title}</span>
                <span class="hl__n">
                  {h.photos.length} photos<span class="sr-only">, play the {h.title} highlight</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </section>

    {
      gallery.highlights.map((h) => (
        <section class="trip" aria-labelledby={`trip-${h.id}`}>
          <header class="trip__head">
            <h2 id={`trip-${h.id}`}>{h.title}</h2>
            <p>
              <span aria-hidden="true">📍</span> {h.place}
            </p>
          </header>
          <ul class="grid">
            {h.photos.map((id, i) => {
              const p = byId.get(id)!;
              const tall = p.h > p.w;
              // On phones, portrait photos sit in pairs; a lone one gets the full width instead.
              const lone = tall && h.photos.filter((x) => byId.get(x)!.h > byId.get(x)!.w).length % 2 === 1;
              return (
                <li class:list={['grid__item', { 'grid__item--tall': tall, 'grid__item--lone': lone, 'grid__item--wide': !tall && i === 0 && h.photos.length > 2 }]}>
                  <button class="grid__btn" type="button" data-story={slides(h.photos)} data-story-title={h.title} data-story-start={i} data-story-browse>
                    <img src={src(id, true)} alt={p.alt} width="640" height={Math.round((p.h / p.w) * 640)} loading="lazy" decoding="async" />
                    <span class="grid__cap">{p.caption}</span>
                  </button>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
    <p class="note">{all.length} photos, all taken by me unless I'm in them. Please ask before reusing any.</p>
  </div>

  <dialog class="story" data-viewer aria-label="Photo viewer">
    <div class="story__bars" data-bars aria-hidden="true"></div>
    <header class="story__top">
      <strong data-v-title></strong>
      <span data-v-place></span>
      <button class="story__close" type="button" data-v-close aria-label="Close">✕</button>
    </header>
    <figure class="story__fig">
      <img data-v-img alt="" />
      <figcaption data-v-cap></figcaption>
    </figure>
    <button class="story__nav story__nav--prev" type="button" data-v-prev aria-label="Previous photo"><span aria-hidden="true">‹</span></button>
    <button class="story__nav story__nav--next" type="button" data-v-next aria-label="Next photo"><span aria-hidden="true">›</span></button>
    <p class="sr-only" aria-live="polite" data-v-status></p>
  </dialog>
</BaseLayout>

<script>
  import { initGallery } from '../../scripts/gallery';
  initGallery();
</script>

<style>
  .hl__list {
    list-style: none;
    margin: 0 0 40px;
    padding: 4px 2px 8px;
    display: flex;
    gap: 22px;
    overflow-x: auto;
  }
  .hl__btn {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  .hl__ring {
    display: block;
    flex: none;
    box-sizing: border-box;
    width: 96px;
    height: 96px;
    padding: 3px;
    border-radius: 50%;
    overflow: hidden;
    background: conic-gradient(from 210deg, #f9ce34, #ee2a7b, #6228d7, #f9ce34);
    transition: transform 0.25s var(--ease-arrive, ease);
  }
  /* Always a perfect circle, whatever the photo's shape (portrait covers used to stretch into an oval). */
  .hl__ring img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    max-width: none;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--bg);
  }
  .hl__btn:hover .hl__ring {
    transform: scale(1.05);
  }
  .hl__title {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 600;
  }
  .hl__n {
    font-size: 12px;
    color: var(--muted);
  }

  .trip {
    margin-bottom: 44px;
  }
  .trip__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    margin-bottom: 14px;
  }
  .trip__head h2 {
    margin: 0;
    font-size: 26px;
  }
  .trip__head p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 200px;
    grid-auto-flow: dense;
    gap: 10px;
  }
  .grid__item {
    grid-column: span 2;
  }
  .grid__item--tall {
    grid-column: span 1;
    grid-row: span 2;
  }
  .grid__item--wide {
    grid-column: span 3;
    grid-row: span 2;
  }
  .grid__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    background: var(--card);
    cursor: zoom-in;
  }
  .grid__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-arrive, ease);
  }
  .grid__btn:hover img {
    transform: scale(1.04);
  }
  .grid__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 28px 14px 10px;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.7));
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
  }
  .note {
    color: var(--muted);
    font-size: 13px;
  }

  /* Story / lightbox viewer */
  .story {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #000;
    color: #fff;
  }
  .story::backdrop {
    background: #000;
  }
  .story[open] {
    display: grid;
    grid-template-rows: auto auto 1fr;
  }
  .story__bars {
    display: flex;
    gap: 4px;
    padding: 10px 14px 0;
  }
  .story__bars :global(i) {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.3);
    overflow: hidden;
  }
  .story__bars :global(b) {
    display: block;
    height: 100%;
    width: 0;
    background: #fff;
  }
  .story__bars :global(i.is-done b) {
    width: 100%;
  }
  .story__top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    font-size: 14px;
  }
  .story__top span {
    color: rgb(255 255 255 / 0.75);
  }
  .story__close {
    margin-left: auto;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    font-size: 18px;
    cursor: pointer;
  }
  .story__fig {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    margin: 0;
    padding: 0 0 18px;
  }
  .story__fig img {
    max-width: min(100%, 1400px);
    max-height: calc(100dvh - 150px);
    object-fit: contain;
    border-radius: 8px;
  }
  .story__fig figcaption {
    margin-top: 10px;
    font-size: 15px;
    color: rgb(255 255 255 / 0.85);
    text-align: center;
    padding: 0 16px;
  }
  .story__nav {
    position: absolute;
    top: 50%;
    width: 48px;
    height: 48px;
    margin-top: -24px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
  }
  .story__nav--prev {
    left: 16px;
  }
  .story__nav--next {
    right: 16px;
  }
  .story__nav:hover,
  .story__close:hover {
    background: rgb(255 255 255 / 0.25);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 150px;
    }
    .grid__item,
    .grid__item--wide {
      grid-column: span 2;
      grid-row: span 1;
    }
    .grid__item--tall {
      grid-column: span 1;
      grid-row: span 2;
    }
    .grid__item--lone {
      grid-column: span 2;
      grid-row: span 3;
    }
    .hl__ring {
      width: 80px;
      height: 80px;
    }
    .story__nav {
      top: auto;
      bottom: 16px;
    }
  }
</style>
